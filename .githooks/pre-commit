#!/bin/sh
# Validate the imported pack, not the historical Poiesis campaign generator.
set -eu

# Validate the same SNBT bytes that will be committed. Refuse partially staged
# SNBT or Packwiz manifests rather than silently checking different content.
python3 - <<'PY'
import subprocess
import sys

staged = subprocess.check_output(
    ['git', 'diff', '--cached', '--name-only', '-z', '--diff-filter=ACMR']
).decode().split('\0')
for path in staged:
    if path.endswith(('.snbt', '.pw.toml')) or path in ('pack.toml', 'index.toml'):
        if subprocess.run(['git', 'diff', '--quiet', '--', path]).returncode:
            print(f'Refusing partial staging for {path}; stage the remaining edits first.')
            sys.exit(1)
PY

printf '%s\n' "==> Refreshing Packwiz and validating Create'a Colony..."
packwiz refresh
python3 scripts/validate_colony.py
python3 scripts/validate_snbt.py --no-color config/
git add -- index.toml pack.toml
