	reward.1A0B1A4E5A9E0641.title: "&aBuilder's Glue: 8 Super Glue"
	reward.1A0B1A4E5A9E0651.title: "&bSurvey Warrant: Explorer's Compass"
	reward.1A0B1A4E5A9E0661.title: "&dCinder Reagent Kit: 8 Arcane Essence"
	reward.1A0B1A4E5A9E0662.title: "&dCinder Reagent Kit: 8 Amethyst Shards"
	reward.1A0B1A4E5A9E0671.title: "&e16 Hardtack"

	task.1A0B1A4E5A9E0511.title: "I Understand the Exchange Rules"
	task.1A0B1A4E5A9E0521.title: "Submit 2 Bevels"
	task.1A0B1A4E5A9E0531.title: "Submit 3 Bevels"
	task.1A0B1A4E5A9E0541.title: "Submit 1 Bevel"
	task.1A0B1A4E5A9E0551.title: "Submit 3 Bevels"
	task.1A0B1A4E5A9E0561.title: "Submit 2 Bevels"
	task.1A0B1A4E5A9E0571.title: "Submit 2 Bevels"
	task.1A0B1A4E5A9E0581.title: "I Understand One Team Cache Means One Claim"
	// BEGIN VvH SEASON ONE
	file.vvh_campaign_version: "2.0.0-dev.1"
	chapter_group.7A11C0DE00000001.title: "Vampires vs Hunters — Season One"
	reward_table.7A11C0DEF0000001.title: "Choose a Personal Trade Lens"
	reward.7A11C0DEF0010001.title: "Builder Lens"
	reward.7A11C0DEF0010002.title: "Engineer Lens"
	reward.7A11C0DEF0010003.title: "Pathfinder Lens"
	reward.7A11C0DEF0010004.title: "Keeper Lens"
	reward.7A11C0DEF0010005.title: "Arcanist Lens"
	reward.7A11C0DEF0010006.title: "Archivist Lens"
	reward_table.7A11C0DEF0000002.title: "Choose a Practical Contribution Favor"
	reward.7A11C0DEF0020001.title: "Eight Andesite Alloy"
	reward.7A11C0DEF0020002.title: "Twelve Arcane Essence"
	reward.7A11C0DEF0020003.title: "Thirty-Two Scaffolding"
