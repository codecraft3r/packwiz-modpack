	chapter.7A11C0DE10000000.title: "VvH 00 · The Island Charter [DEV REVIEW]"
	quest.7A11C0DE10000001.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lTHE ISLAND NEEDS A MEMORY"
		""
		"&fAn island becomes home when useful work survives the person who started it."
		"&fSeason One turns faction identity, public works, rivalries, and records into reasons to return."
		""
		"&eRead the three reference clauses around this page, then sign the short charter below.&f They separate real hard protections from rules that only work because friends agree to honor them."
		""
		"&8Leave behind something a later player can use."
	]
	quest.7A11C0DE10000001.quest_subtitle: "Two minutes now; fewer arguments at 1:30 a.m."
	quest.7A11C0DE10000001.title: "&6&lOPEN THE ISLAND CHARTER"
	task.7A11C0DE10100001.title: "Open the Charter"
	quest.7A11C0DE10000003.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&a&lBUILD WHERE THE WORLD REMEMBERS"
		""
		"&fHomes, faction halls, markets, roads, memorials, public machines, and lore sites belong only on land the host has explicitly confirmed permanent."
		"&fAny announced reset zone is an expedition site, not a place for irreplaceable work. Claims are hard boundaries only where the live FTB Chunks configuration really enforces them."
		""
		"&cNo prank, theft, faction stunt, or contract overrides another team's protected claim or explicit consent."
		""
		"&8If the reset eats your cathedral, the cathedral was camping."
	]
	quest.7A11C0DE10000003.quest_subtitle: "[OPTIONAL REFERENCE] Permanent work needs a boundary that actually means something."
	quest.7A11C0DE10000003.title: "&aLAND, CLAIMS, AND RESET ZONES"
	task.7A11C0DE10100003.title: "I Know the Permanent-Land and Claim Rule"
	quest.7A11C0DE10000005.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lTHE FUNNY WAR CLAUSE"
		""
		"&fVampires and Hunters may compete through banners, mascots, markets, races, scavenger hunts, public challenges, expeditions, ward demonstrations, architecture, and reversible wilderness mischief."
		"&fNeutrals may trade, mediate, scout, judge, rescue, courier, host, or sell services to either side without becoming a consolation faction."
		""
		"&cNo claim intrusion, theft, spawn camping, targeted harassment, irreversible sabotage, or destruction wearing a comedy moustache."
		"&fCombat is a scheduled opt-in event only, with a host, backup, stop condition, protected noncombatants, and rebuild plan. Winning never grants progression power."
		""
		"&8A prank with a cleanup crew is a bit. A crater is an incident."
	]
	quest.7A11C0DE10000005.quest_subtitle: "[OPTIONAL REFERENCE] Make stories, not support tickets."
	quest.7A11C0DE10000005.title: "&dRIVALRY, NEUTRALS, AND OPTIONAL COMBAT"
	task.7A11C0DE10100005.title: "I Accept the Rivalry and Optional-Combat Boundary"
	quest.7A11C0DE10000006.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&6&lONE BODY, ONE PARTY, TWO KINDS OF ALLEGIANCE"
		""
		"&fVampirism now provides real Vampire and Hunter factions. FTB Teams provides shared quest progress and FTB Chunks ownership. Season One uses both, but it does not automatically synchronize them."
		""
		"&eA Vampirism advancement records that an event happened; it is not a live faction-state detector forever."
		"&fBefore a faction team claims shared foundation supplies, one teammate or the host confirms that the team is presently aligned with that faction."
		"&fAsk the host before joining, leaving, or switching an FTB party. Claims, storage, contracts, and quest history must be checked rather than guessed."
		""
		"&8The bureaucracy has developed fangs."
	]
	quest.7A11C0DE10000006.quest_subtitle: "[OPTIONAL REFERENCE] Two faction systems exist. Do not pretend they are the same database."
	quest.7A11C0DE10000006.title: "&6VAMPIRISM, FTB TEAMS, AND SWITCHING"
	task.7A11C0DE10100006.title: "I Understand Vampirism Faction vs FTB Team State"
	quest.7A11C0DE10000008.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lTHE FOUR-LINE VERSION"
		""
		"&f1. Build irreplaceable work only on confirmed permanent land."
		"&f2. Claims and consent outrank rivalry, contracts, and bits."
		"&f3. Combat is optional, scheduled, supervised, and reversible."
		"&f4. Vampirism faction state and FTB team state are separate; switches need a quick host review."
		""
		"&7Lore:&f Nessa Quill signs as courier because Greybridge taught her that an agreement nobody can find is only a rumour."
		"&eObjective:&f Inspect one lantern, then sign the charter after reading the boundary clauses."
		"&aStandard:&f The lantern inspection is a non-consuming preview; the checkmark records the human review."
		""
		"&6Starter nudge:&f one Compass and eight Torches."
	]
	quest.7A11C0DE10000008.quest_subtitle: "Inspect one lantern, then sign the charter; claims remain dependency-locked."
	quest.7A11C0DE10000008.title: "&6&lSIGN THE CHARTER"
	task.7A11C0DE10100008.title: "Human Review: Sign the Island Charter"
	reward.7A11C0DE10200002.title: "Personal Compass"
	reward.7A11C0DE10200003.title: "Eight Travel Torches"
	reward.7A11C0DE10200004.title: "Two Arcane Essence"

	chapter.7A11C0DE11000000.title: "VvH 01 · Three Invitations [DEV REVIEW]"
	quest.7A11C0DE11000001.quest_desc: [
		"{image:minecraft:textures/item/compass_16.png width:48 height:48 align:center}"
		"&6&lTHREE LEGITIMATE WAYS TO BELONG"
		""
		"&4Vampires&f gain a real supernatural progression and are asked to turn that identity into hospitality, ritual spaces, night infrastructure, and civic obligations."
		"&bHunters&f gain their own real progression and are asked to turn vigilance into safe roads, public knowledge, workshops, and reliable refuge."
		"&aNeutrals&f remain human/non-aligned and become the connective tissue: trade, contracts, mapping, MCA civic life, rescue, logistics, and arbitration."
		""
		"&eNothing here is permanent.&f Switching is allowed, but it creates social and claim bookkeeping. Pick the role you actually want to play this week, not the reward you think is numerically best."
		""
		"&8The Atlas has stopped pretending the word 'faction' is metaphorical."
	]
	quest.7A11C0DE11000001.quest_subtitle: "Choose what kind of problem you want to become useful at."
	quest.7A11C0DE11000001.title: "&6&lREAD THE THREE INVITATIONS"
	task.7A11C0DE11100001.title: "Read All Three Invitations"
	quest.7A11C0DE11000002.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&4&lTHE HOUSE OF NIGHT"
		""
		"&fComplete Vampirism's &eBecome a Vampire&f advancement, then click the second task after your current faction choice and intended FTB team are clear to at least one other player or the host."
		""
		"&7The advancement is historical evidence, not a permanent live-state lock. If you later cure/switch, the old page remains part of your story rather than becoming a loophole for fresh foundation caches."
		""
		"&8Please file all immortality paperwork before sunrise."
	]
	quest.7A11C0DE11000002.quest_subtitle: "Become a Vampire, then register the choice socially."
	quest.7A11C0DE11000002.title: "&4&lTAKE THE CRIMSON INVITATION"
	task.7A11C0DE11100015.title: "Become a Vampire"
	task.7A11C0DE11100016.title: "Our Current Allegiance and FTB Team Are Clear"
	reward.7A11C0DE11200017.title: "Two Blood Bottles"
	reward.7A11C0DE11200018.title: "One Blood Rune"
	quest.7A11C0DE11000003.quest_desc: [
		"{image:vampirism:textures/item/garlic.png width:48 height:48 align:center}"
		"&b&lTHE LANTERN ORDER"
		""
		"&fComplete Vampirism's &eBecome a Hunter&f advancement, then click the second task after your current faction choice and intended FTB team are clear to at least one other player or the host."
		""
		"&7The advancement records that you joined at least once. Later betrayal/switching does not erase history, so shared caches still use peer/host confirmation of current allegiance."
		""
		"&8The official uniform is 'prepared'. The cape remains under committee review."
	]
	quest.7A11C0DE11000003.quest_subtitle: "Become a Hunter, then register the choice socially."
	quest.7A11C0DE11000003.title: "&b&lTAKE THE LANTERN OATH"
	task.7A11C0DE1110001F.title: "Become a Hunter"
	task.7A11C0DE11100020.title: "Our Current Allegiance and FTB Team Are Clear"
	reward.7A11C0DE11200021.title: "Four Garlic Field Supplies"
	reward.7A11C0DE11200022.title: "One Holy Rune"
	quest.7A11C0DE11000004.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&a&lTHE FREE COMPANIES"
		""
		"&fRemain outside Vampire and Hunter alignment for now. Name one service you want to be known for: courier work, maps, market brokerage, MCA diplomacy, rescue, hospitality, construction, intelligence, or event hosting."
		""
		"&eClick after another player knows what service you offer.&f Neutrality is a playable civic role with its own foundation chapter, not a beige skip button."
		""
		"&8Somebody has to invoice the supernatural."
	]
	quest.7A11C0DE11000004.quest_subtitle: "Stay neutral on purpose, not by forgetting to choose."
	quest.7A11C0DE11000004.title: "&a&lSIGN THE FREE COMPANY REGISTER"
	task.7A11C0DE11100029.title: "I Registered a Neutral Service With Another Player"
	reward.7A11C0DE1120002B.title: "Four Emerald Service Tokens"
	reward.7A11C0DE1120002C.title: "One Arcane Rune"
	quest.7A11C0DE11000005.quest_desc: [
		"&7Lore:&f The Atlas records three invitations as three working promises: night, light, and an open road. Nessa Quill will carry the reply only if the welcome point can receive an actual guest."
		"&fObjective:&f Lay out eight lanterns, set aside sixteen loaves, and open one shared welcome point."
		"&fStandard:&f The entrance is reachable, lit, stocked, and visibly open to a player who did not build it."
	]
	quest.7A11C0DE11000005.quest_subtitle: "Three invitations become one welcome a stranger can use."
	quest.7A11C0DE11000005.title: "&6&lTHREE INVITATIONS"
	task.7A11C0DE11100033.title: "I Know What Kind of Work I Want First"
	reward.7A11C0DE11200034.title: "Choose a Personal Starter Kit"
	chapter.7A11C0DE12000000.title: "VvH 02 · House of Night"
	quest.7A11C0DE12000001.quest_desc: [
		"&4&lLORE — THE HOUSE THAT MUST ANSWER"
		"&fMirelle Voss still keeps the Greybridge truce in her throat. She failed to shelter people then; Nessa Quill carried the surviving guest list out by hand."
		"&fMirelle cannot say whether the failure was cowardice, a false instruction, or a door she thought was safe. She can say what the next House will do."
		""
		"&eOBJECTIVE&f Choose the House of Night as your foundation after accepting the Crimson Invitation."
		"&7BUILD STANDARD&f Name the headquarters. Record whether its guest rule begins with anonymous shelter or a named ledger."
		"&fThe choice changes the House's first promise, not anyone's access to magic."
	]
	quest.7A11C0DE12000001.quest_subtitle: "Starter · Solo-friendly"
	quest.7A11C0DE12000001.title: "[CHARTER] FOUND THE HOUSE"
	task.7A11C0DE1210000B.title: "Accept the Crimson Invitation and become a vampire"
	task.7A11C0DE1210000C.title: "REVIEW: Record the House's first guest promise"
	quest.7A11C0DE12000002.quest_desc: [
		"&a&lLORE — SLEEP WITHOUT EXPLANATION"
		"&fNessa's list names people who needed a door, not a sermon. Give the House a room where a guest can sleep, put things down, and find the way out in the dark."
		""
		"&eOBJECTIVE&f Build the common coffin room."
		"&7BUILD STANDARD&f Provide a usable guest space, labelled storage, and an obvious lit exit."
	]
	quest.7A11C0DE12000002.quest_subtitle: "Starter · Solo-friendly"
	quest.7A11C0DE12000002.title: "[WORLD] COMMON ROOM"
	task.7A11C0DE12100015.title: "Carry a Red Coffin"
	task.7A11C0DE12100016.title: "REVIEW: The House Has a Shared Sleeping/Recovery Space"
	quest.7A11C0DE12000003.quest_desc: [
		"&e&lLORE — THE ALTAR IS A DESK"
		"&fBlood practice begins with a place to prepare carefully. Mirelle wants the first altar kept where another person can ask what is being done before it is done."
		""
		"&eOBJECTIVE&f Place an Altar of Inspiration and demonstrate one safe preparation."
		"&7PROOF&f Carry one Altar of Inspiration for inspection; this item proof is not consumed. Complete the review checkmark after the shared, visible preparation is demonstrated."
		"&7BUILD STANDARD&f The altar is accessible, labelled, and not hidden inside a private combat room."
	]
	quest.7A11C0DE12000003.quest_subtitle: "Starter · Solo-friendly"
	quest.7A11C0DE12000003.title: "[PROGRESSION] SET THE ALTAR"
	task.7A11C0DE1210001F.title: "Carry an Altar of Inspiration for inspection (not consumed)"
	task.7A11C0DE12100020.title: "REVIEW: The first preparation is safe and explainable"
	quest.7A11C0DE12000004.quest_desc: [
		"&a&lLORE — STOCK THAT DOES NOT SPOIL"
		"&fThe pantry is the House's one hospitality work: blood bottles, glass, and a label that tells a late arrival what may be used. It is a store of trust, not a cooking assignment."
		""
		"&eOBJECTIVE&f Stock the Blood pantry."
		"&7BUILD STANDARD&f Keep emergency bottles visible, labelled, and available to the shared refuge."
	]
	quest.7A11C0DE12000004.quest_subtitle: "Workshop · Team-friendly"
	quest.7A11C0DE12000004.title: "[WORLD] BLOOD PANTRY"
	task.7A11C0DE12100029.title: "Carry 4 Blood Bottles"
	task.7A11C0DE1210002A.title: "REVIEW: A Labelled Shared Blood Pantry Exists"
	quest.7A11C0DE12000005.quest_desc: [
		"&e&lLORE — THE CAULDRON AND THE QUESTION"
		"&fNessa's list has gaps where preparation happened too quickly. The House answers with a workstation that can be inspected, taught, and stopped before hunger turns a lesson into a debt."
		""
		"&eOBJECTIVE&f Place an Alchemical Cauldron and demonstrate one controlled preparation."
		"&7PROOF&f Carry one Alchemical Cauldron for inspection; this item proof is not consumed. Complete the review checkmark after the controlled preparation is visible and teachable."
		"&7BUILD STANDARD&f Store its materials safely and let another player explain what the preparation is for."
	]
	quest.7A11C0DE12000005.quest_subtitle: "Workshop · Team-friendly"
	quest.7A11C0DE12000005.title: "[PROGRESSION] PREPARE THE CAULDRON"
	task.7A11C0DE12100033.title: "Carry an Alchemical Cauldron for inspection (not consumed)"
	task.7A11C0DE12100034.title: "REVIEW: A controlled preparation is stored and teachable"
	quest.7A11C0DE12000006.quest_desc: [
		"&a&lLORE — A DARK ROAD IS STILL A ROAD"
		"&fThe guest list records where people stopped being visible. Lanterns do not solve that history, but a marked night route gives the next traveller a chance to be found."
		""
		"&eOBJECTIVE&f Mark and light a safe route to the House."
		"&7BUILD STANDARD&f The route has readable markers, a rest point, and enough lighting to follow home."
	]
	quest.7A11C0DE12000006.quest_subtitle: "Route · Solo-friendly"
	quest.7A11C0DE12000006.title: "[WORLD] MARK THE NIGHT ROAD"
	task.7A11C0DE1210003D.title: "REVIEW: A Signed Night Route Connects Two Useful Places"
	quest.7A11C0DE12000007.quest_desc: [
		"&a&lLORE — THE LANTERN LEFT ON"
		"&fMirelle's old instructions ended at the threshold. Keep one light burning beyond it, with a spare place for someone who arrives late and does not know the House's manners yet."
		""
		"&eOBJECTIVE&f Establish the House's public refuge lighting."
		"&7BUILD STANDARD&f Light the approach and guest area; leave a small, labelled emergency supply."
	]
	quest.7A11C0DE12000007.quest_subtitle: "Route · Team-friendly"
	quest.7A11C0DE12000007.title: "[WORLD] LEAVE THE LIGHT ON"
	task.7A11C0DE12100047.title: "Two Players Visited the House for a Tour, Meal, Trade, or Ceremony"
	quest.7A11C0DE12000008.quest_desc: [
		"&e&lLORE — IMMORTALITY STILL MOVES SUPPLIES"
		"&fA refuge fails quietly when bottles, tools, and messages cannot reach it. Give the House one Create service that moves something useful and can be understood by the next pair of hands."
		""
		"&eOBJECTIVE&f Demonstrate a Mechanical Press in a shared logistics line."
		"&7PROOF&f Carry one Mechanical Press for inspection; this item proof is not consumed. Complete the review checkmark after the shared line moves a useful House supply."
		"&7BUILD STANDARD&f The line serves a House function such as storage, route loading, or public workshop supply."
	]
	quest.7A11C0DE12000008.quest_subtitle: "Advanced · Team-friendly"
	quest.7A11C0DE12000008.title: "[PROGRESSION] MOVE THE NIGHT STOCK"
	task.7A11C0DE12100051.title: "Carry a Mechanical Press for inspection (not consumed)"
	task.7A11C0DE12100052.title: "REVIEW: Create logistics serve a shared House function"
	quest.7A11C0DE12000009.quest_desc: [
		"&e&lLORE — INHERITANCE IS NOT INSTRUCTION"
		"&fA Blood Rune and Bloody Vellum can preserve a method, but neither can tell a new practitioner when to stop. Keep the first focus small, labelled, and teachable."
		""
		"&eOBJECTIVE&f Prepare a Blood Rune and Bloody Vellum as the House's introductory school focus."
		"&7PROOF&f Carry one Blood Rune and one Bloody Vellum for inspection; neither item is consumed."
		"&fBorrowed, purchased, or received Blood materials are valid. This proof changes no Vampirism faction or rank and grants no spell-tier skip."
		"&7BUILD STANDARD&f Store the focus safely and explain one controlled, non-escalating use to another player."
	]
	quest.7A11C0DE12000009.quest_subtitle: "Advanced · Solo-friendly"
	quest.7A11C0DE12000009.title: "[PROGRESSION] INSCRIBE BLOOD"
	task.7A11C0DE1210005B.title: "Carry a Blood Rune for inspection (not consumed)"
	task.7A11C0DE1210005C.title: "Carry Bloody Vellum for inspection (not consumed)"
	task.7A11C0DE1210005D.title: "REVIEW: A Blood focus is stored and explainable"
	quest.7A11C0DE1200000A.quest_desc: [
		"&4&lLORE — A HOUSE WITH OBLIGATIONS"
		"&fMirelle will not call five works a repair of Greybridge. She will call them a place where the next decision can be made in public."
		"&fNessa's surviving list stays beside the maintenance rota, so the House remembers who was welcomed and who was missed."
		""
		"&eOBJECTIVE&f Complete any 5 of the 8 works, including at least one progression work and one world-building work."
		"&7BUILD STANDARD&f Name the headquarters and record one maintenance owner or rotation."
		""
		"&6CONSEQUENCE&f Choose whether the first shared rule is anonymous shelter or a named guest ledger; the optional House depth arc follows that decision."
	]
	quest.7A11C0DE1200000A.quest_subtitle: "Advanced · Team-friendly"
	quest.7A11C0DE1200000A.title: "[CHARTER] CHARTER THE HOUSE"
	task.7A11C0DE12100065.title: "Complete 5 of 8 House works"
	task.7A11C0DE12100066.title: "Name the headquarters and maintenance rotation"
	reward.7A11C0DE12200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE12200068.title: "Four Super Glue"
	reward.7A11C0DE12200069.title: "Two Blood Runes"
	reward.7A11C0DE1220006A.title: "Choose One Practical Contribution Favor"

	chapter.7A11C0DE13000000.title: "VvH 03 · Lantern Order"
	quest.7A11C0DE13000001.quest_desc: [
		"{image:poiesis:textures/questpics/vvh/lantern_order.png width:48 height:48 align:center}"
		"&b&lFOUND THE LANTERN ORDER"
		""
		"&6Lore:&f Warden Elias Rook got civilians out of Greybridge, then left a vampire refuge behind the flood line. He still calls it triage."
		"&fNessa Quill's route record disputes the last safe turn. The Order begins with that uncertainty, not a clean legend."
		"&eObjective:&f Complete five of eight works, including at least one [PROGRESSION] and one [WORLD] work."
		"&fName the headquarters and record who keeps its doors, supplies, or route notes usable."
		"&aBuild Standard:&f A host or two-player review confirms the work is findable, usable by a visitor, and assigned a maintenance handoff."
		"&7[SUITABLE: STARTER TEAMS / REFUGE STEWARDS]"
	]
	quest.7A11C0DE13000001.quest_subtitle: "[CHARTER] A protective order learns from the route it failed to keep."
	quest.7A11C0DE13000001.title: "[CHARTER] &b&lLANTERN OATH"
	task.7A11C0DE1310000B.title: "At Least One Teammate Has Become a Hunter"
	task.7A11C0DE1310000C.title: "Current Hunter Alignment Confirmed for This FTB Team"
	quest.7A11C0DE13000002.quest_desc: [
		"&6Lore:&f Rook's old watchhouse had a bell, but no map for the people who needed it. Quill's contradictory record is pinned beside the new route notes."
		"&eObjective:&f Build a starter watchhouse, gatehouse, or civic room for refuge and public safety, with hazards, routes, contacts, and shelter instructions. An existing building counts."
		"&aBuild Standard:&f A visitor can identify the entrance, a safe guest area, and the next useful destination without its owner present; this is not an armor or combat check."
		"&7[SUITABLE: STARTER / REFUGE / PUBLIC SAFETY; EXISTING BUILDINGS COUNT]"
	]
	quest.7A11C0DE13000002.quest_subtitle: "[WORLD] A starter refuge and public-safety build; existing buildings count."
	quest.7A11C0DE13000002.title: "[WORLD] &a&lWATCHHOUSE"
	task.7A11C0DE13100015.title: "REVIEW: The Watchhouse Has Public Information and a Safe Guest Area"
	quest.7A11C0DE13000003.quest_desc: [
		"&6Lore:&f The Order's table is where field preparation becomes shared knowledge: one person remembers the recipe, another remembers who needs it."
		"&eObjective:&f Place a Hunter Table in a shared workshop and demonstrate one real preparation or support use."
		"&aBuild Standard:&f The station has labelled storage and enough access for a teammate to use it without moving private equipment."
		"&7[SUITABLE: PROGRESSION / SHARED SUPPORT]"
	]
	quest.7A11C0DE13000003.quest_subtitle: "[PROGRESSION] Prepare a shared support station."
	quest.7A11C0DE13000003.title: "[PROGRESSION] &e&lHUNTER TABLE"
	task.7A11C0DE1310001F.title: "Carry a Hunter Table"
	task.7A11C0DE13100020.title: "REVIEW: The Hunter Table Is Installed in a Shared Workshop"
	quest.7A11C0DE13000004.quest_desc: [
		"&6Lore:&f Nessa's route notes mark three places where a patrol found people waiting with no food, light, or direction. The field cache is the Order's answer to one of them."
		"&eObjective:&f Establish a labelled garlic and first-response reserve with a written restock handoff."
		"&aBuild Standard:&f A non-builder can find the cache, understand what may be taken, and know who restores it."
		"&7[SUITABLE: WORLD / LOGISTICS STEWARDS]"
	]
	quest.7A11C0DE13000004.quest_subtitle: "[WORLD] Keep a public reserve findable and restocked."
	quest.7A11C0DE13000004.title: "[WORLD] &a&lFIELD CACHE"
	task.7A11C0DE13100029.title: "Carry 8 Garlic"
	task.7A11C0DE1310002A.title: "REVIEW: A Labelled Shared Garlic/Field-Supply Reserve Exists"
	quest.7A11C0DE13000005.quest_desc: [
		"&6Lore:&f A stake is a tool; the Order decides what it is for before it puts one in a trainee's hand."
		"&eObjective:&f Assemble four stakes and run a controlled equipment or field-medicine demonstration."
		"&aBuild Standard:&f The demonstration has a safe practice area and a clear rule that no player becomes a target without consent."
		"&7[SUITABLE: PROGRESSION / TOOL PREPARATION]"
	]
	quest.7A11C0DE13000005.quest_subtitle: "[PROGRESSION] Prepare tools for a controlled support drill."
	quest.7A11C0DE13000005.title: "[PROGRESSION] &e&lSTAKE KIT"
	task.7A11C0DE13100033.title: "Carry 4 Stakes"
	task.7A11C0DE13100034.title: "REVIEW: A Safe Training/Equipment Area Exists"
	quest.7A11C0DE13000006.quest_desc: [
		"&6Lore:&f Greybridge taught Rook that a countermeasure prepared too late is only a story about preparation."
		"&eObjective:&f Install an Alchemical Cauldron with labelled ingredients and demonstrate one cleansing, medical, or support preparation."
		"&aBuild Standard:&f The bench is accessible, its ingredients are readable, and the team can explain what the preparation is for."
		"&7[SUITABLE: PROGRESSION / CARE SUPPORT]"
	]
	quest.7A11C0DE13000006.quest_subtitle: "[PROGRESSION] Turn preparation into a readable care service."
	quest.7A11C0DE13000006.title: "[PROGRESSION] &e&lALCHEMICAL BENCH"
	task.7A11C0DE1310003D.title: "Carry an Alchemical Cauldron"
	task.7A11C0DE1310003E.title: "REVIEW: The Cauldron Has a Safe Shared Work Area"
	quest.7A11C0DE13000007.quest_desc: [
		"&6Lore:&f Quill's route record ends at a turn Rook remembers as impassable. The Order keeps the route open long enough to find out which memory failed."
		"&eObjective:&f Mark a lit refuge route between the Order and a useful public destination, including hazards and a fallback point."
		"&aBuild Standard:&f Someone unfamiliar with the route can follow it without voice guidance."
		"&7[SUITABLE: WORLD / NAVIGATION STEWARDS]"
	]
	quest.7A11C0DE13000007.quest_subtitle: "[WORLD] Make a public refuge route legible at night."
	quest.7A11C0DE13000007.title: "[WORLD] &a&lREFUGE ROUTE"
	task.7A11C0DE13100047.title: "REVIEW: A Signed, Lit Refuge Route Connects Two Useful Places"
	quest.7A11C0DE13000008.quest_desc: [
		"&6Lore:&f The first response drill is deliberately uncomfortable: the Order must discover what its maps omit before a real traveller does."
		"&eObjective:&f Run a night escort, lost-player retrieval, cleansing response, evacuation, or shelter test."
		"&aBuild Standard:&f Another player reviews the result, or a solo route audit logs one failure and the fix applied."
		"&7[SUITABLE: WORLD / SOLO ROUTE AUDIT]"
	]
	quest.7A11C0DE13000008.quest_subtitle: "[WORLD] Solo option available · test one response handoff."
	quest.7A11C0DE13000008.title: "[WORLD] &a&lRESPONSE DRILL"
	task.7A11C0DE13100051.title: "Solo option available: route audit; log one failure and apply one fix"
	quest.7A11C0DE13000009.quest_desc: [
		"&6Lore:&f Holy practice is not a trophy for winning a hunt. It is the quiet work of keeping a room clean, a wound tended, and a frightened traveller inside the light."
		"&eObjective:&f Install one Holy Rune in one of three accepted public examples: a public ward, medical station, or shelter desk, and demonstrate its safe use."
		"&aBuild Standard:&f The station explains what it does and how a visitor receives help; rune inspection is non-consuming, and no vampire target or kill is required."
		"&7[SUITABLE: PROGRESSION / PUBLIC CARE]"
	]
	quest.7A11C0DE13000009.quest_subtitle: "[PROGRESSION] Inspect a public Holy Rune service without consuming it."
	quest.7A11C0DE13000009.title: "[PROGRESSION] &e&lHOLY WARD"
	task.7A11C0DE1310005B.title: "Carry a Holy Rune"
	task.7A11C0DE1310005C.title: "REVIEW: A Holy Ward Is Installed and Its Use Is Explained"
	quest.7A11C0DE1300000A.quest_desc: [
		"&6Lore:&f Rook calls the charter a correction. Quill calls it an admission. Both are written into the same ledger."
		"&eObjective:&f Complete five of eight works, including at least one [PROGRESSION] and one [WORLD] work, then record the headquarters and its maintenance handoff."
		"&aBuild Standard:&f The review tasks name the completed works and confirm the Order serves people beyond its builders."
		"&7[SUITABLE: CHARTER / ANY TEAM]"
	]
	quest.7A11C0DE1300000A.quest_subtitle: "[CHARTER] Five of eight works, with both lanes represented."
	quest.7A11C0DE1300000A.title: "[CHARTER] &b&lLANTERN CHARTER"
	task.7A11C0DE13100065.title: "A Progression Work and a World-Build Work Are Named"
	task.7A11C0DE13100066.title: "Headquarters Named; Maintenance Owner Recorded"
	reward.7A11C0DE13200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE13200068.title: "Four Super Glue"
	reward.7A11C0DE13200069.title: "Two Holy Runes"
	reward.7A11C0DE1320006A.title: "Choose One Practical Contribution Favor"

	chapter.7A11C0DE14000000.title: "VvH 04 · Free Companies"
	quest.7A11C0DE14000001.quest_desc: [
	    "&fLore:&f Nessa Quill founded this company after carrying both Greybridge accounts across the salt road."
	    "&fShe cannot prove which faction altered the route record; both sides owe her, and both have friends she refuses to abandon."
	    "&eObjective:&f Sign the Free Company register after completing the neutral register in Chapter 1."
	    "&7Build Standard:&f Name one contract steward and one place where a solo visitor can leave a request."
	]
	quest.7A11C0DE14000001.quest_subtitle: "Charter · Solo-friendly"
	quest.7A11C0DE14000001.title: "[CHARTER] FOUND A FREE COMPANY"
	task.7A11C0DE1410000B.title: "Current Neutral/Independent Status Confirmed With Another Player"
	quest.7A11C0DE14000002.quest_desc: [
	    "&fLore:&f Orra Vale lost a week to a contract board whose terms were written on both sides of the same page."
	    "&fNessa wants one public board showing who asked, what is owed, and when the promise expires."
	    "&eObjective:&f Build and stock a public contract board with three distinct job types."
	    "&7Build Standard:&f The board is reachable from the common route, has a named steward, and records three current offers."
	]
	quest.7A11C0DE14000002.quest_subtitle: "World · Team-friendly"
	quest.7A11C0DE14000002.title: "[WORLD] OPEN THE CONTRACT HALL"
	task.7A11C0DE14100015.title: "REVIEW: A Public Contract Board Has At Least 3 Clear Job Types"
	quest.7A11C0DE14000003.quest_desc: [
	    "&fLore:&f Nessa once delivered a sealed letter to the wrong watchtower because a route marker had been moved for a festival. The letter was harmless; the feud it interrupted was not."
	    "&eObjective:&f Mark a neutral courier route between two useful places with a filled map."
	    "&7Build Standard:&f Show the route, its destination, and one safe stopping point. Solo players may submit a signed route audit."
	]
	quest.7A11C0DE14000003.quest_subtitle: "World · Solo-friendly"
	quest.7A11C0DE14000003.title: "[WORLD] MARK A COURIER ROUTE"
	task.7A11C0DE1410001F.title: "Carry a Filled Map"
	task.7A11C0DE14100020.title: "REVIEW: A Named Courier Route Connects Two Useful Places"
	quest.7A11C0DE14000004.quest_desc: [
	    "&fLore:&f The first neutral market failed when its Blood apothecary and Lantern carpenter arrived on different days."
	    "&fThey blamed each other for the empty stall. Nessa now keeps the opening hours in one visible place."
	    "&eObjective:&f Establish a public market stall or contract market with storage and lighting."
	    "&7Build Standard:&f Provide three active offers or services, public terms, neutral access, and a named steward."
	]
	quest.7A11C0DE14000004.quest_subtitle: "World · Team-friendly"
	quest.7A11C0DE14000004.title: "[WORLD] OPEN A NEUTRAL MARKET"
	task.7A11C0DE14100029.title: "REVIEW: A Stall or Counter Lists Goods/Services and Contact Terms"
	quest.7A11C0DE14000005.quest_desc: [
	    "&fLore:&f When the route record was altered, a tired courier slept beside the gate and missed its only witness."
	    "&fNessa is building a place where travellers can recover before they sign anything."
	    "&eObjective:&f Build a guesthouse or waystation on the neutral route."
	    "&7Build Standard:&f Include a bed, food, lighting, storage, and a clearly marked public entrance."
	]
	quest.7A11C0DE14000005.quest_subtitle: "World · Team-friendly"
	quest.7A11C0DE14000005.title: "[WORLD] OPEN A WAYSTATION"
	task.7A11C0DE14100033.title: "REVIEW: A Neutral Guest/Meeting Space Can Host 2 Players"
	quest.7A11C0DE14000006.quest_desc: [
	    "&fLore:&f Nessa's ledger contains two versions of the Greybridge route. The names match; the dates do not. A courier learns faster when every delivery carries its own chain of custody."
	    "&eObjective:&f Carry a filled map and complete one courier delivery under two visible seals."
	    "&7Build Standard:&f Record the sender, destination, seal marks, and the correction made if the route was wrong. Solo players may submit a signed test log."
	]
	quest.7A11C0DE14000006.quest_subtitle: "Progression · Solo-friendly"
	quest.7A11C0DE14000006.title: "[PROGRESSION] COURIER UNDER TWO SEALS"
	task.7A11C0DE1410003D.title: "REVIEW: A Shared Ledger Records At Least 3 Contracts, Places, or Decisions"
	quest.7A11C0DE14000007.quest_desc: [
	    "&fLore:&f Iven translated a Blood ward with a Holy glossary and left out the word for surrender."
	    "&fNobody was hurt, but the door stayed sealed for three days. The Free Company now publishes safe examples."
	    "&eObjective:&f Prepare a PUBLIC SPELLWRIGHT service with Arcane Essence and demonstrate one safe utility procedure."
	    "&7Build Standard:&f Show the prepared material and a signed procedure. This is preparation and demonstration only; it is not Blood/Holy interpretation or a power skip."
	    "&fBorrowed, purchased, or received materials are valid without faction allegiance; solo players may self-audit."
	]
	quest.7A11C0DE14000007.quest_subtitle: "Progression · Solo-friendly · preparation/demo"
	quest.7A11C0DE14000007.title: "[PROGRESSION] PUBLIC SPELLWRIGHT"
	task.7A11C0DE14100047.title: "REVIEW: We Used MCA/Civic Play to Create One Named Relationship or Place"
	quest.7A11C0DE14000008.quest_desc: [
	    "&fLore:&f A Lantern patrol found a stranded traveller beside a Blood-marked bridge. Nessa sent bread first and questions second."
	    "&fThe rescue worked because someone had recorded who could help without starting a faction dispute."
	    "&eObjective:&f Run one mediation or rescue procedure and record the result."
	    "&7Build Standard:&f Name the problem, the neutral response, and the follow-up. Solo players may interact with an MCA resident or submit a self-audit."
	]
	quest.7A11C0DE14000008.quest_subtitle: "Progression · Team-friendly"
	quest.7A11C0DE14000008.title: "[PROGRESSION] MEDIATE OR RESCUE"
	task.7A11C0DE14100051.title: "A Posted Service Request Was Resolved or Reviewed"
	quest.7A11C0DE14000009.quest_desc: [
	    "&fLore:&f The translation desk began with a Blood rune, a Holy rune, and Nessa's refusal to copy either without a warning."
	    "&fIts first useful result was not a weapon; it was one safe instruction that both sides could read."
	    "&eObjective:&f Open the TRANSLATION DESK with Arcane Essence and document one limited Blood or Holy interpretation."
	    "&7Build Standard:&f Keep the example available to visitors, record its safety limit, and do not prepare or cast it as a power skip."
	    "&fBorrowed, purchased, or received materials are valid without faction allegiance; this desk documents interpretation only."
	]
	quest.7A11C0DE14000009.quest_subtitle: "Progression · Solo-friendly · interpretation/documentation"
	quest.7A11C0DE14000009.title: "[PROGRESSION] OPEN THE TRANSLATION DESK"
	task.7A11C0DE1410005B.title: "Carry 2 Arcane Essence"
	task.7A11C0DE1410005C.title: "REVIEW: One Safe Blood or Holy Utility Is Documented"
	quest.7A11C0DE1400000A.quest_desc: [
	    "&fLore:&f A charter is not a majority vote from one lane. Nessa will sign when five distinct works are standing."
	    "&fAt least one route, service, or spell procedure must answer a visitor's question."
	    "&eObjective:&f Complete any five of the eight Free Company works."
	    "&7Build Standard:&f The five must include at least one world-building work and one progression/service work."
	]
	quest.7A11C0DE1400000A.quest_subtitle: "Charter · Team-friendly · 5 of 8"
	quest.7A11C0DE1400000A.title: "[CHARTER] CHARTER THE FREE COMPANY"
	task.7A11C0DE14100065.title: "A Progression Work and a World-Build Work Are Named"
	task.7A11C0DE14100066.title: "Headquarters Named; Maintenance Owner Recorded"
	reward.7A11C0DE14200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE14200068.title: "Four Super Glue"
	reward.7A11C0DE14200069.title: "Eight Arcane Essence"
	reward.7A11C0DE1420006A.title: "Choose One Practical Contribution Favor"

	chapter.7A11C0DE15000000.title: "VvH 05 · The Work Each Hand Knows"
	quest.7A11C0DE15000001.quest_desc: [
	  "&6Lore:&f After Greybridge, Nessa needs a machine understood after its builder leaves. Mirelle needs a ritual that does not rely on one keeper."
	  "&fElias needs a ledger that says who can safely use what."
	  "&fChoose any three specialty projects. The other five remain open choices, not a hidden eight-quest checklist."
	  "&fStandard:&7 Work may be solo or shared. Record your own result and failure, or have another player demonstrate the service."
	]
	quest.7A11C0DE15000001.quest_subtitle: "Choose any three specialties"
	quest.7A11C0DE15000001.title: "&6&lWORK TOGETHER"
	task.7A11C0DE15100001.title: "Read the Eight Contribution Routes"
	quest.7A11C0DE15000002.quest_desc: [
	  "&6Lore:&f Nessa's Greybridge press jammed because nobody marked the order of operations. She wants a small service another person can restart without guessing."
	  "&bSuitability:&f [Workshop] [Technical] [Solo-friendly]"
	  "&fObjective:&7 Carry 4 Create Andesite Alloys for inspection; they are not consumed. Demonstrate or solo-test one repeatable machine service."
	  "&fOutput:&7 Leave a labelled service card naming inputs, order, output, restart point, and one failure or maintenance note."
	  "&fStandard:&7 Another player may repeat the service; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000002.quest_subtitle: "[Workshop] [Technical] · make a machine teachable"
	quest.7A11C0DE15000002.title: "&6[SPECIALTY] ENGINEER"
	task.7A11C0DE15100015.title: "Carry 4 Andesite Alloys for inspection (not consumed)"
	task.7A11C0DE15100016.title: "REVIEW: A Create Service Solves a Shared Problem"
	quest.7A11C0DE15000003.quest_desc: [
	  "&6Lore:&f Mirelle Voss translated a Greybridge ward from memory and reversed one line. The ward held, but it held the wrong doorway. She needs a method with a visible first step."
	  "&bSuitability:&f [Magic] [Research] [Solo-friendly]"
	  "&fObjective:&7 Carry 4 Arcane Essences for inspection; they are not consumed. Demonstrate or solo-test one repeatable spell-preparation step."
	  "&fOutput:&7 Leave a safe preparation card naming the first step, materials, expected result, and one limit or failure warning."
	  "&fStandard:&7 A partner may reproduce the step; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000003.quest_subtitle: "[Magic] [Research] · make one spell step teachable"
	quest.7A11C0DE15000003.title: "&d[SPECIALTY] ARCANIST"
	task.7A11C0DE1510001F.title: "Carry 4 Arcane Essences for inspection (not consumed)"
	task.7A11C0DE15100020.title: "REVIEW: A Spell/Ingredient/Upgrade Tip Is Published"
	quest.7A11C0DE15000004.quest_desc: [
	  "&6Lore:&f Elias Rook once called a night guest by the wrong title at Greybridge. The insult became a security problem."
	  "&fHe now asks for one clear sign that tells strangers what a threshold means."
	  "&bSuitability:&f [Magic] [Faction] [Social]"
	  "&fObjective:&7 Carry 1 Vampire Fang for inspection; it is not consumed. Demonstrate or solo-test one Blood or faction-facing procedure."
	  "&fOutput:&7 Publish one threshold sign or procedure card with the welcome rule, boundary, response, and escalation contact."
	  "&fStandard:&7 Another player may follow the procedure; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000004.quest_subtitle: "[Magic] [Faction] [Social] · translate one night custom"
	quest.7A11C0DE15000004.title: "&4[SPECIALTY] NIGHT SPECIALIST"
	task.7A11C0DE15100029.title: "REVIEW: I Taught or Documented One Vampirism Mechanic for Someone Else"
	quest.7A11C0DE15000005.quest_desc: [
	  "&6Lore:&f Nessa's Greybridge courier arrived with a working vehicle and no safe place to land. The first useful aeronautics contribution is a visible, low-tier landing site."
	  "&bSuitability:&f [Build] [Workshop] [Route] [Solo-friendly]"
	  "&fObjective:&7 Carry 16 Scaffolding for inspection; it is not consumed. Demonstrate or solo-test a safe vehicle-site procedure."
	  "&fOutput:&7 Mark one low-tier landing site with an approach, parking or tie-down point, safety boundary, and a written arrival test."
	  "&fStandard:&7 Another player may inspect the test; solo players sign the result or failure. Players who want the later Wing project may pursue it elsewhere, but it is not required here."
	]
	quest.7A11C0DE15000005.quest_subtitle: "[Build] [Workshop] [Route] · make a landing site usable"
	quest.7A11C0DE15000005.title: "&b[SPECIALTY] AERONAUT"
	task.7A11C0DE15100033.title: "REVIEW: A Vehicle/Airframe Test or Dock Improvement Was Documented"
	quest.7A11C0DE15000006.quest_desc: [
	  "&6Lore:&f Mirelle Voss rang the Greybridge bell once for welcome and once for alarm. Nobody had written down which was which. She asks for a signal that two sides can read the same way."
	  "&bSuitability:&f [Build] [Social] [Faction] [Solo-friendly]"
	  "&fObjective:&7 Carry 1 Bell for inspection; it is not consumed. Demonstrate or solo-test one public signal or mediation procedure."
	  "&fOutput:&7 Publish a two-state signal code (welcome and alarm) with its response, visible placement, and one recorded test."
	  "&fStandard:&7 Another player may answer the signal; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000006.quest_subtitle: "[Build] [Social] [Faction] · make one signal legible"
	quest.7A11C0DE15000006.title: "&a[SPECIALTY] DIPLOMAT"
	task.7A11C0DE1510003D.title: "Another Player Confirms a Trade, MCA, Faction, or Civic Agreement"
	quest.7A11C0DE15000007.quest_desc: [
	  "&6Lore:&f Elias Rook's Greybridge relief crate held food, torches, and no label. The right supplies reached the wrong hands. He asks for a field kit that can be checked at a glance."
	  "&bSuitability:&f [Build] [Logistics] [Support] [Solo-friendly]"
	  "&fObjective:&7 Carry 2 Barrels for inspection; they are not consumed. Demonstrate or solo-test one labelled public kit."
	  "&fOutput:&7 Stock and label one field kit with an inventory list, issue rule, restock owner, and one witnessed or self-audited use."
	  "&fStandard:&7 Another player may use the kit; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000007.quest_subtitle: "[Build] [Logistics] [Support] · stock one field kit"
	quest.7A11C0DE15000007.title: "&e[SPECIALTY] QUARTERMASTER"
	task.7A11C0DE15100047.title: "REVIEW: A Shared Travel or Emergency Supply Station Served At Least 2 Players"
	quest.7A11C0DE15000008.quest_desc: [
	  "&6Lore:&f Nessa's Greybridge map showed the destination and omitted the dangerous bridge. A route is only useful when the next person can survive following it."
	  "&bSuitability:&f [Route] [Exploration] [Navigation] [Solo-friendly]"
	  "&fObjective:&7 Carry 1 Filled Map for inspection; it is not consumed. Demonstrate or solo-test one route with its hazard and result recorded."
	  "&fOutput:&7 Publish a survivable route record naming both endpoints, one hazard, one safe stop, a caretaker, and the correction tested."
	  "&fStandard:&7 Another player may follow the route; solo players sign the test with the observed result or failure."
	]
	quest.7A11C0DE15000008.quest_subtitle: "[Route] [Exploration] [Navigation] · publish one survivable route"
	quest.7A11C0DE15000008.title: "&a[SPECIALTY] PATHFINDER"
	task.7A11C0DE15100051.title: "Carry 1 Filled Map for inspection (not consumed)"
	task.7A11C0DE15100052.title: "REVIEW: A New Route/Map Is Usable Without Voice Chat"
	quest.7A11C0DE15000009.quest_desc: [
	  "&6Lore:&f Mirelle Voss remembers Greybridge's failure differently from Elias Rook, and both accounts leave out the moment the plan broke. The archive needs the gap, not a polished legend."
	  "&bSuitability:&f [Archive] [Research] [Solo-friendly]"
	  "&fObjective:&7 Carry 1 Writable Book for inspection; it is not consumed. Demonstrate or solo-test one archive procedure."
	  "&fOutput:&7 File one archive entry naming the event, source, result, uncertainty or failure, and the next test another player should run."
	  "&fStandard:&7 Another player may review the record; solo players sign their own record and name what failed."
	]
	quest.7A11C0DE15000009.quest_subtitle: "[Archive] [Research] · preserve one useful failure"
	quest.7A11C0DE15000009.title: "&f[SPECIALTY] ARCHIVIST"
	task.7A11C0DE1510005B.title: "REVIEW: A Failure, Fix, or Weird Event Was Archived With a Useful Lesson"
	quest.7A11C0DE1500000A.quest_desc: [
	  "&6Lore:&f Three different crafts kept Greybridge from collapsing completely. Close the gate after any three are proven, then let the rest remain invitations rather than obligations."
	  "&fObjective:&7 Complete any 3 of the 8 specialties, then review what the settlement can now do."
	  "&fStandard:&7 A solo player may document the review; a team may have another player verify it."
	]
	quest.7A11C0DE1500000A.quest_subtitle: "Any three specialties unlock the handoff"
	quest.7A11C0DE1500000A.title: "&6&lTHREE HANDS"
	task.7A11C0DE15100065.title: "Record Which Three Routes I Contributed"
	reward.7A11C0DE15200066.title: "Choose a Practical Contribution Favor"

	chapter.7A11C0DE16000000.title: "VvH 06 · The Island Remembers"
	quest.7A11C0DE16000001.quest_desc: [
	    "{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
	    "&6&lLORE"
	    "&fGreybridge failed for practical reasons: routes had no owner, refuges had no honest capacity, and three records described the same disaster differently."
	    "&fNessa wants the island's existing works linked before contradiction becomes infrastructure. Mirelle calls a findable route the first rescue."
	    "&fElias calls a record that survives its author the first rescue."
	    ""
	    "&e&lOBJECTIVE"
	    "&fComplete any &e3 of 6&f public upgrades below. Upgrade, link, test, or maintain an existing work; a new build is welcome only when no equivalent exists."
	    ""
	    "&a&lSTANDARD"
	    "&fLeave the result usable by a stranger and record one owner, route, or corrective action. Solo logs and self-audits count."
	]
	quest.7A11C0DE16000001.quest_subtitle: "Link what already exists. Make one useful thing survive its first failure."
	quest.7A11C0DE16000001.title: "&6&lTHE ISLAND REMEMBERS"
	task.7A11C0DE16100001.title: "Read the Public-Works Rubric"
	quest.7A11C0DE16000002.quest_desc: [
	    "&6&lLORE"
	    "&fMirelle circles the map where two old roads nearly meet. She does not ask for another road; she asks for the missing sign, bridge, rail spur, or caretaker that makes the old one dependable."
	    ""
	    "&e&lOBJECTIVE"
	    "&fWALK-THROUGH: Upgrade, link, test, or maintain an existing route, rail, path, or Via Romana line between two useful locations; mark both endpoints and the signage."
	    "&fEXISTING BUILDS COUNT: An existing road, bridge, rail spur, path, or Via Romana line counts when its endpoints, signs, and maintenance owner are made usable."
	    "&fSOLO AUDIT: Walk endpoint-to-endpoint, take one deliberate wrong turn, verify the signs recover the route, and log the caretaker plus one correction."
	    ""
	    "&a&lSTANDARD"
	    "&fAn unbriefed traveller can identify both endpoints, follow the signs, and find the maintenance owner. A solo player may log and correct one navigation failure."
	]
	quest.7A11C0DE16000002.quest_subtitle: "Link two useful places and prove the link survives a wrong turn."
	quest.7A11C0DE16000002.title: "&eCONNECTED ROUTE"
	task.7A11C0DE16100015.title: "REVIEW: Route survives a wrong turn and has a named caretaker"
	quest.7A11C0DE16000003.quest_desc: [
	    "&6&lLORE"
	    "&fElias finds Greybridge's oldest contract written on the back of a receipt. Mirelle calls it proof that markets need rules. Elias calls it proof that rules need somewhere public to be read."
	    ""
	    "&e&lOBJECTIVE"
	    "&fLIVE SERVICE: Upgrade an existing market, stall, contract board, or trade room into a public hall with three active offers or services, visible terms, and one tested transaction."
	    "&fEXISTING BUILDS COUNT: An existing market, stall, contract board, or trade room counts when neutral access, a steward, and readable terms are added or repaired."
	    "&fSOLO AUDIT: Perform and log one transaction from a posted offer, including its price or terms, outcome, and one corrected rule or confusing sign."
	    ""
	    "&a&lSTANDARD"
	    "&fNeutral access, visible terms, and a named steward are present. A solo player may perform and log a test transaction or correct one confusing rule."
	]
	quest.7A11C0DE16000003.quest_subtitle: "Turn an existing stall into a place where terms survive the seller."
	quest.7A11C0DE16000003.title: "&6MARKET AND CONTRACT HALL"
	task.7A11C0DE1610001F.title: "REVIEW: Three active services and a readable public contract"
	quest.7A11C0DE16000004.quest_desc: [
	    "&6&lLORE"
	    "&fThe workshop survived because somebody labelled one chest. The depot failed because nobody labelled the second."
	    "&fNessa asks for an upgrade joining machine access, repair stock, and a clear line between public and personal tools."
	    ""
	    "&e&lOBJECTIVE"
	    "&fMACHINE TEST: Substantially upgrade an existing workshop or depot so two useful capabilities, a process or repair test, and public/private stock boundaries are obvious."
	    "&fEXISTING BUILDS COUNT: An existing workshop, machine room, tool wall, or depot counts when two capabilities and their public/private stock are labelled and maintained."
	    "&fSOLO AUDIT: Run one processing or repair job start-to-finish, record the result or failure, and correct one broken step, label, or stock boundary."
	    ""
	    "&a&lSTANDARD"
	    "&fTwo capabilities work, operating rules are visible, and a maintainer is named. A solo player may run a repair or processing test and record one corrected failure."
	]
	quest.7A11C0DE16000004.quest_subtitle: "Make the useful tools reachable without making them mysteriously vanish."
	quest.7A11C0DE16000004.title: "&6SHARED WORKSHOP AND DEPOT"
	task.7A11C0DE16100029.title: "REVIEW: Two useful capabilities work and stock boundaries are clear"
	quest.7A11C0DE16000005.quest_desc: [
	    "&6&lLORE"
	    "&fGreybridge kept three accounts of the same night and trusted none. Elias wants five verifiable memories a later player can compare."
	    "&fMirelle insists the record must also admit what remains uncertain."
	    ""
	    "&e&lOBJECTIVE"
	    "&fSOURCE CHECK: Upgrade an existing archive, map room, memorial, museum, or gallery with five verifiable world facts, their sources, and a place for the sixth."
	    "&fEXISTING BUILDS COUNT: An existing archive, map room, memorial, museum, or gallery counts when its records are browseable, located or dated, and open to a source audit."
	    "&fSOLO AUDIT: Select one entry, trace it to its source, record the fact and uncertainty or correction, and add the audit to the archive log."
	    ""
	    "&a&lSTANDARD"
	    "&fThe facts are browseable, dated or located, and include one uncertainty or correction. A solo player may audit one entry and add its source."
	]
	quest.7A11C0DE16000005.quest_subtitle: "Leave the next witness more than your version of events."
	quest.7A11C0DE16000005.title: "&fARCHIVE AND MEMORIAL"
	task.7A11C0DE16100033.title: "REVIEW: Five sourced memories and one correction are browseable"
	quest.7A11C0DE16000006.quest_desc: [
	    "&6&lLORE"
	    "&fGreybridge's refuge was large enough on paper and full enough in practice. Mirelle asks for capacity that can be counted, while Elias asks for an exit that can be found when the lamps are out."
	    ""
	    "&e&lOBJECTIVE"
	    "&fDRILL: Upgrade an existing refuge, alarm point, lit retreat, or emergency station and run a capacity, exit, supplies, and evacuation test."
	    "&fEXISTING BUILDS COUNT: An existing refuge, alarm point, lit retreat, or emergency station counts when its capacity is counted, supplies are ready, and an exit route is marked."
	    "&fSOLO AUDIT: Start at the alarm point, time a simulated evacuation to the refuge and its exit, count usable places and supplies, then sign the maintenance log with one correction."
	    ""
	    "&a&lSTANDARD"
	    "&fThe station is findable under pressure and one failure is corrected. A solo player may self-audit the route and sign the maintenance log."
	]
	quest.7A11C0DE16000006.quest_subtitle: "Test the shelter before the island tests it for you."
	quest.7A11C0DE16000006.title: "&cTHREAT REFUGE AND READINESS"
	task.7A11C0DE1610003D.title: "REVIEW: Refuge capacity, exit route, and one corrected failure"
	quest.7A11C0DE16000007.quest_desc: [
	    "&6&lLORE"
	    "&fThe island's first public event ended at a locked door and a landing field with no safe edge."
	    "&fNessa treats arrival and gathering as one promise: people can reach it, use it, and tell what happened there."
	    ""
	    "&e&lOBJECTIVE"
	    "&fHOSTED TEST: Upgrade an existing dock, hangar, vehicle depot, meeting room, stage, or event ground into one usable public arrival-and-gathering space, then test arrival and one venue function."
	    "&fEXISTING BUILDS COUNT: An existing dock, hangar, vehicle depot, meeting room, stage, or event ground counts when its safe approach and public function are marked and usable."
	    "&fSOLO AUDIT: Arrive by the marked approach, run one event or venue function end-to-end, record the attendance or result, and correct one access or safety failure."
	    ""
	    "&a&lSTANDARD"
	    "&fMark a safe approach, provide one useful vehicle or venue function, and host or self-audit one event/test with a recorded correction."
	]
	quest.7A11C0DE16000007.quest_subtitle: "Give arrivals somewhere to land, gather, and be remembered."
	quest.7A11C0DE16000007.title: "&bPUBLIC VENUE AND ARRIVAL WORKS"
	task.7A11C0DE16100047.title: "REVIEW: Safe arrival and one usable public event/test"
	quest.7A11C0DE1600000B.quest_desc: [
	    "&6&lLORE"
	    "&fMirelle and Elias stop arguing when the first three works can be used without their builders present. Nessa files the result under Greybridge's missing reconciliation."
	    ""
	    "&e&lOBJECTIVE"
	    "&fComplete any three of the six public upgrades. Place one record of the finished set in the archive or public depot."
	    ""
	    "&a&lSTANDARD"
	    "&fEach chosen work is usable by a stranger and has a named route, steward, test, or correction. The team reward funds maintenance, not a technology skip."
	]
	quest.7A11C0DE1600000B.quest_subtitle: "Choose three upgrades. Make the choice legible."
	quest.7A11C0DE1600000B.title: "&6&lTHREE THINGS THE ISLAND KEEPS"
	task.7A11C0DE1610006F.title: "Archive One Record of the Three Public Works"
	reward.7A11C0DE16200070.title: "Sixteen Maintenance Lanterns"
	reward.7A11C0DE16200071.title: "Thirty-Two Maintenance Scaffolding"
	reward.7A11C0DE16200072.title: "Choose a Public Works Supply Cache"

	chapter.7A11C0DE17000000.title: "VvH 07 · Rivalry Without Ruin"
	quest.7A11C0DE17000001.quest_desc: ["{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}" "&d&lLORE" "&fGreybridge broke during a public demonstration. Mirelle Voss remembers the bell as a warning; Elias Rook remembers it as permission. Nessa Quill filed both statements under the same date." "" "&e&lOBJECTIVE" "&fPublish a venue, participants, stop time, cleanup owner, and two formats that everyone can decline without penalty." "" "&9&lSUITABILITY" "&fSolo: rules audit | Group: host formats | Build: venue, boundaries, and cleanup station." "" "&a&lEVENT STANDARD" "&fUse reversible props, visible boundaries, and a written result. The ordinary path is two noncombat events; the skirmish is a separate, runtime-unverified option."]
	quest.7A11C0DE17000001.quest_subtitle: "[EVENT] Prepare the rules, then choose any two harmless formats."
	quest.7A11C0DE17000001.title: "[EVENT] &d&lRIVALRY NIGHT"
	task.7A11C0DE17100001.title: "Publish the Rivalry Rules"
	quest.7A11C0DE17000002.quest_desc: ["&d&lLORE" "&fMirelle's copy of the Greybridge notice says: ‘Ring once, then wait.’ Elias's margin says the second ring saved them. The contradiction becomes a banner, not a verdict." "" "&e&lOBJECTIVE" "&fCreate one reversible poster, banner, exhibit, or museum label that quotes or paraphrases one side of the bell story." "" "&9&lSUITABILITY" "&fSolo: display audit | Group: paired accounts | Build: reversible poster, banner, or exhibit." "" "&a&lEVENT STANDARD" "&fFor a group, both sides display a piece. For a solo audit, place one display beside a signed note naming the source and its removal time. Do not place it in another player's claim without permission."]
	quest.7A11C0DE17000002.quest_subtitle: "[EVENT] Make a reversible accusation that can survive daylight."
	quest.7A11C0DE17000002.title: "[EVENT] &dPROPAGANDA"
	task.7A11C0DE17100015.title: "Display One Reversible Bell Account"
	quest.7A11C0DE17000003.quest_desc: ["&e&lLORE" "&fElias remembers the demonstration failing because the ward was explained after it flashed. The Lantern Order insists the explanation is part of the ward." "" "&e&lOBJECTIVE" "&fStage a Blood-versus-Holy utility demonstration, route briefing, or support-station test against an environmental target or dummy space." "" "&9&lSUITABILITY" "&fSolo: test log | Group: safety briefing | Build: support station or marked demo space." "" "&a&lEVENT STANDARD" "&fFor a group, at least three people can judge or attend. For a solo audit, record the setup, expected result, observed result, and one safe adjustment. No unwilling target, combat spell, or faction change is required."]
	quest.7A11C0DE17000003.quest_subtitle: "[EVENT] Demonstrate protection without making a person the target."
	quest.7A11C0DE17000003.title: "[EVENT] &eWARD TEST"
	task.7A11C0DE1710001F.title: "Record a Safe Ward Test"
	quest.7A11C0DE17000004.quest_desc: ["&a&lLORE" "&fNessa Quill found three copies of the same route with three different final bells. She kept the maps because the walk mattered more than the answer." "" "&e&lOBJECTIVE" "&fPlace a short clue course ending at a public project, harmless trophy, or location reveal, then remove or archive every clue." "" "&9&lSUITABILITY" "&fSolo: timed route audit | Group: solve together | Build: clue trail with removable markers." "" "&a&lEVENT STANDARD" "&fFor a group, participants solve the route. For a solo audit, run it against your own recorded time and one failure note. The final record names what was learned and where the clues went."]
	quest.7A11C0DE17000004.quest_subtitle: "[EVENT] Leave a trail that teaches something when it ends."
	quest.7A11C0DE17000004.title: "[EVENT] &aCLUE COURSE"
	task.7A11C0DE17100029.title: "Run and Archive a Clue Course"
	quest.7A11C0DE17000005.quest_desc: ["&b&lLORE" "&fThe old courier ledger has two arrival times for the same Greybridge crate. One is written in ink; the other is corrected in charcoal after the bell." "" "&e&lOBJECTIVE" "&fPublish a start, finish, allowed transport, route, and safety rule for a foot, rail, boat, glider, or vehicle run." "" "&9&lSUITABILITY" "&fSolo: repeat-run audit | Group: route relay | Build: marked route and finish." "" "&a&lEVENT STANDARD" "&fFor a group, record the route and a visible finish. For a solo audit, run it twice, record the times and one failure/recovery, and leave the route usable for the next courier."]
	quest.7A11C0DE17000005.quest_subtitle: "[EVENT] Publish the route before anyone starts moving."
	quest.7A11C0DE17000005.title: "[EVENT] &bCOURIER RUN"
	task.7A11C0DE17100033.title: "Publish and Run a Safe Courier Route"
	quest.7A11C0DE17000006.quest_desc: ["&6&lLORE" "&fNessa's archive calls the first Greybridge market a truce. Elias calls it a queue. Mirelle calls it the only hour nobody asked which side rang the bell." "" "&e&lOBJECTIVE" "&fSet a time window and procurement or service benchmark: gather a real bundle, fill a shortage, or complete a useful delivery." "" "&9&lSUITABILITY" "&fSolo: service audit | Group: publish a benchmark | Build: neutral desk or delivery point." "" "&a&lEVENT STANDARD" "&fFor a group, publish the result and the terms. For a solo audit, record the target, inputs, elapsed time, and actual output. No fake trades, duplicated goods, or currency loop."]
	quest.7A11C0DE17000006.quest_subtitle: "[EVENT] Measure a service without inventing a transaction."
	quest.7A11C0DE17000006.title: "[EVENT] &6MARKET TEST"
	task.7A11C0DE1710003D.title: "Publish a Market Benchmark"
	quest.7A11C0DE17000007.quest_desc: ["&f&lLORE" "&fThe bell fragment is still displayed beside a half-built arch. Nessa wrote: ‘A structure can be wrong and still be honest if its maker leaves the measurements.’" "" "&e&lOBJECTIVE" "&fPresent a mascot, one-chunk build, ceremonial object, or public display with a three-line rubric: readable, reversible, and useful or memorable." "" "&9&lSUITABILITY" "&fSolo: self-score | Group: independent judges | Build: mascot, one-chunk build, or public display." "" "&a&lEVENT STANDARD" "&fFor a group, invite judges or independent categories. For a solo audit, sign your own score against the rubric and record one change you would make. Keep the object only with its owner's consent."]
	quest.7A11C0DE17000007.quest_subtitle: "[EVENT] Judge a small object by a stated rule, not by power."
	quest.7A11C0DE17000007.title: "[EVENT] &fBUILD RUBRIC"
	task.7A11C0DE17100047.title: "Submit a Rubric-Judged Build"
	quest.7A11C0DE17000008.quest_desc: ["&c&lLORE" "&fThe Greybridge demonstration did not end because anyone won. It ended because the crowd could not tell who had agreed to be in danger." "" "&e&lOBJECTIVE" "&fOnly after two noncombat formats, schedule a fully opt-in skirmish with a roster, loadout ceiling, arena, spectator protection, backup, stop command, and restoration owner." "" "&9&lSUITABILITY" "&fSolo: checklist rehearsal only | Group: consented roster | Build: marked arena and restoration plan." "" "&a&lEVENT STANDARD" "&fThis node is runtime unverified and must remain unused until controls are tested. Completion means a safe end and agreed restoration—not kills, victory, or faction power."]
	quest.7A11C0DE17000008.quest_subtitle: "[PVP · CONSENT REQUIRED] Optional hosted PvP only after two noncombat formats; record consent, roster, safe stop, and restoration owner."
	quest.7A11C0DE17000008.title: "[PVP · CONSENT REQUIRED] &cSANCTIONED SKIRMISH"
	task.7A11C0DE17100051.title: "[PVP · CONSENT REQUIRED] Confirm consent, roster, safe stop, and restoration owner (or choose a noncombat alternative)"
	quest.7A11C0DE17000009.quest_desc: ["&d&lLORE" "&fNessa Quill never corrected Mirelle or Elias. She placed both bell accounts in the same folder and left a blank page for the next witness." "" "&e&lOBJECTIVE" "&fArchive two event results, the cleanup status, one concrete moment, and one unresolved question or change for next time." "" "&9&lSUITABILITY" "&fSolo: record audit | Group: shared archive | Build: book, signs, map wall, or archive chest." "" "&a&lEVENT STANDARD" "&fUse a book, signs, map wall, or archive chest that a late player can find. The archive is reachable without the skirmish; no PvP result is required."]
	quest.7A11C0DE17000009.quest_subtitle: "[CAPSTONE] After any two safe formats, leave a useful record."
	quest.7A11C0DE17000009.title: "[CAPSTONE] &d&lARCHIVE THE NIGHT"
	task.7A11C0DE1710005B.title: "Archive Two Results and One Open Question"
	reward.7A11C0DE1720005C.title: "Sixteen Firework Rockets"
	reward.7A11C0DE1720005D.title: "Eight Festival Lanterns"
	reward.7A11C0DE1720005E.title: "Choose a Rivalry Supply Cache"

	chapter.7A11C0DE18000000.title: "VvH 08 · The Long Night Fair"
	quest.7A11C0DE18000001.quest_desc: ["&6&lLORE" "&fGreybridge's truce collapsed during a public demonstration. Mirelle Voss and Elias Rook still describe the same bell differently; Nessa Quill archived both versions." "" "&e&lOBJECTIVE" "&fChoose a venue, post the invitation, name hosts and cleanup owners, and display the bell fragment, demonstration ledger, route map, or two witness notes without pretending the contradiction is solved." "" "&9&lSUITABILITY" "&fSolo: staged preparation audit | Group: host the fair | Build: venue, stations, and archive display." "" "&a&lEVENT STANDARD" "&fThe preferred fair has visitors and shared stations. A solo preparation audit may use a staged venue, signed hosting plan, and NPC-facing invitation. The six contributions are alternatives; any three complete the fair."]
	quest.7A11C0DE18000001.quest_subtitle: "[EVENT] Set one place, one time, and one unresolved history on the table."
	quest.7A11C0DE18000001.title: "[EVENT] &6&lCALL THE FAIR"
	task.7A11C0DE18100001.title: "Post the Fair Plan and Evidence"
	quest.7A11C0DE18000002.quest_desc: ["&4&lLORE" "&fMirelle's host book lists a bloodless toast beside the bell fragment: ‘We remember differently; sit anyway.’" "" "&e&lOBJECTIVE" "&fHost a Vampire's Delight table, night-route tour, ritual study, archive reading, or aesthetic exhibit." "" "&9&lSUITABILITY" "&fSolo: staged hospitality audit | Group: host guests | Build: table, exhibit, or route stop." "" "&a&lEVENT STANDARD" "&fFor the fair, guests participate safely and leave with one remembered detail. For a solo audit, stage the table or exhibit, sign the guest protocol, and record the intended audience or NPC visitor."]
	quest.7A11C0DE18000002.quest_subtitle: "[EVENT] Give the night a table without asking for allegiance."
	quest.7A11C0DE18000002.title: "[EVENT] &4HOUSE HOSPITALITY"
	task.7A11C0DE18100015.title: "Stage Hospitality and a Guest Record"
	quest.7A11C0DE18000003.quest_desc: ["&b&lLORE" "&fElias's margin note says the bell was safe only after somebody explained the exit. The Lantern Order turns that note into a public ward lesson." "" "&e&lOBJECTIVE" "&fHost a safety demonstration, route briefing, rescue drill, countermeasure museum, or support station." "" "&9&lSUITABILITY" "&fSolo: signed test log | Group: teach visitors | Build: support station or marked lesson space." "" "&a&lEVENT STANDARD" "&fFor the fair, visitors can practice or learn without being targets. For a solo audit, stage the display against the environment and sign a test log with expected and observed results."]
	quest.7A11C0DE18000003.quest_subtitle: "[EVENT] Explain a danger before it becomes a spectacle."
	quest.7A11C0DE18000003.title: "[EVENT] &bLANTERN SERVICE"
	task.7A11C0DE1810001F.title: "Run a Public Safety Demonstration"
	quest.7A11C0DE18000004.quest_desc: ["&a&lLORE" "&fNessa's archive calls the first neutral desk a place where both bell accounts could be delivered without changing hands." "" "&e&lOBJECTIVE" "&fOperate a market, contract desk, courier service, map desk, guesthouse, mediation table, or event logistics station." "" "&9&lSUITABILITY" "&fSolo: documented service test | Group: run one interaction | Build: neutral desk, guesthouse, or logistics station." "" "&a&lEVENT STANDARD" "&fFor the fair, publish terms and complete one real interaction. For a solo audit, post the terms, complete a documented service or route test, and leave the desk ready for a visitor."]
	quest.7A11C0DE18000004.quest_subtitle: "[EVENT] Make one neutral service actually useful."
	quest.7A11C0DE18000004.title: "[EVENT] &aFREE COMPANY MARKET"
	task.7A11C0DE18100029.title: "Operate One Neutral Service"
	quest.7A11C0DE18000005.quest_desc: ["&6&lLORE" "&fThe demonstration ledger has a missing line where the bell should have been tested. The workshop fills that gap with an operator, a spectator line, and a failure note." "" "&e&lOBJECTIVE" "&fDemonstrate a Create system, vehicle, dock, rail feature, workshop, or controlled engineering test." "" "&9&lSUITABILITY" "&fSolo: controlled test log | Group: explain and run it | Build: marked workshop, dock, or machine exhibit." "" "&a&lEVENT STANDARD" "&fFor the fair, explain the system and run it once with marked zones. For a solo audit, stage the display, run the test, and sign the expected result, observed result, and repair hook."]
	quest.7A11C0DE18000005.quest_subtitle: "[EVENT] Let one machine explain itself before it moves."
	quest.7A11C0DE18000005.title: "[EVENT] &6ENGINEERING EXHIBITION"
	task.7A11C0DE18100033.title: "Run a Controlled Machine Demonstration"
	quest.7A11C0DE18000006.quest_desc: ["&e&lLORE" "&fA witness remembered the bell by the sound of the crowd afterward. The fair keeps that human detail: a game, ceremony, music cue, or guided tour that ends with someone taking part." "" "&e&lOBJECTIVE" "&fRun a performance, mini-game, ceremony, award, speech, guided tour, or other shared activity." "" "&9&lSUITABILITY" "&fSolo: staged test run | Group: participate together | Build: stage, game lane, or tour route." "" "&a&lEVENT STANDARD" "&fFor the fair, announce how to join and show a visible ending. For a solo audit, stage the activity, write the joining instructions, and record a test run or NPC audience response."]
	quest.7A11C0DE18000006.quest_subtitle: "[EVENT] Give visitors a reason to participate."
	quest.7A11C0DE18000006.title: "[EVENT] &ePUBLIC SHOWCASE"
	task.7A11C0DE1810003D.title: "Run a Participatory Showcase"
	quest.7A11C0DE18000007.quest_desc: ["&f&lLORE" "&fThe archive does not choose between Mirelle and Elias. It preserves the bell fragment, both witness notes, the demonstration ledger, and the route that led people home." "" "&e&lOBJECTIVE" "&fPreserve five concrete season facts, images, maps, quotes, results, or failures and identify one unfinished hook." "" "&9&lSUITABILITY" "&fSolo: signed archive audit | Group: browse and contribute | Build: durable archive with next-page marker." "" "&a&lEVENT STANDARD" "&fFor the fair, make the record browseable for a late player. For a solo audit, sign and file the five entries in a durable archive with a clearly marked next page."]
	quest.7A11C0DE18000007.quest_subtitle: "[EVENT] Preserve five facts and leave one door open."
	quest.7A11C0DE18000007.title: "[EVENT] &fARCHIVE THE SEASON"
	task.7A11C0DE18100047.title: "File Five Season Facts"
	quest.7A11C0DE18000009.quest_desc: ["&6&lLORE" "&fAt the fair's last bell, Mirelle and Elias still disagree. Nessa's blank page is not an invitation to invent a clean answer; it is a promise that the next season may examine the evidence." "" "&e&lOBJECTIVE" "&fComplete any three fair contributions and record one unresolved pressure or ambition that players genuinely want to continue." "" "&6&lSEASON SEAL REWARDS" "&f3 personal Bevels + personal fair favor + team festival support. No currency is added to reward table #9." "" "&9&lSUITABILITY" "&fSolo: staged seal audit | Group: gather at the fair | Build: capstone venue and sequel-hook archive." "" "&a&lEVENT STANDARD" "&fThe preferred capstone is a real public gathering. A solo seal audit must point to three staged contribution records and one signed sequel hook; it does not pretend a crowd attended."]
	quest.7A11C0DE18000009.quest_subtitle: "[CAPSTONE] Complete any three contributions, then name what remains unresolved."
	quest.7A11C0DE18000009.title: "[CAPSTONE] &6&lSEAL SEASON ONE"
	task.7A11C0DE1810005B.title: "Seal the Fair and Leave a Future Hook"
	reward.7A11C0DE1820005C.title: "Sixteen Festival Lanterns"
	reward.7A11C0DE1820005D.title: "Choose a Long Night Fair Favor"

	chapter.7A11C0DE19000000.title: "VvH 09 · After the Bells"
	quest.7A11C0DE19000001.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lROUTE · DELIVERY · PUBLIC DESTINATION"
		""
		"&7&lLORE:&f The Atlas closes the season ledger after the seal. Nessa Quill keeps the post-season courier route open, carrying useful caches to places the island already uses."
		"&e&lOBJECTIVE:&f Choose a public service, name its route and destination, and agree who will receive and place the team cache."
		"&a&lSTANDARD:&f Submit the visible Bevel price only after the payer, delivery route, public destination, and handoff owner are written down. Each paid service renews after seven days."
	]
	quest.7A11C0DE19000001.quest_subtitle: "Post-season services for routes and public destinations the island actually uses."
	quest.7A11C0DE19000001.title: "&6&lAFTER THE BELLS"
	task.7A11C0DE19100001.title: "Read the Civic Requisition Terms"
	quest.7A11C0DE19000002.quest_desc: [
		"&7Lore:&f Nessa Quill's first delivery is deliberately ordinary: a dark route is still a real obstacle when somebody arrives late."
		"&fObjective:&f Submit 1 Bevel for sixteen lanterns and thirty-two torches."
		"&fStandard:&f Name the public route, refuge, hall, or event that will receive the team cache."
	]
	quest.7A11C0DE19000002.quest_subtitle: "An early route cache for the first shared works."
	quest.7A11C0DE19000002.title: "&eLIGHTING REQUISITION — 1 BEVEL"
	task.7A11C0DE19100015.title: "Submit 1 Bevel"
	reward.7A11C0DE19200016.title: "Sixteen Public Lanterns"
	reward.7A11C0DE19200017.title: "Thirty-Two Public Torches"
	quest.7A11C0DE19000003.quest_desc: [
		"&7Lore:&f Nessa has learned that a route fails at its missing link, not at its grandest station. The first rail cache belongs wherever the team can extend travel next."
		"&fObjective:&f Submit 2 Bevels for thirty-two rails and eight powered rails."
		"&fStandard:&f Choose a named public route; stations, redstone, and engineering remain the team's work."
	]
	quest.7A11C0DE19000003.quest_subtitle: "A modest transit cache for a route with somewhere to go."
	quest.7A11C0DE19000003.title: "&6TRANSIT REQUISITION — 2 BEVELS"
	task.7A11C0DE1910001F.title: "Submit 2 Bevels"
	reward.7A11C0DE19200020.title: "Thirty-Two Rails"
	reward.7A11C0DE19200021.title: "Eight Powered Rails"
	quest.7A11C0DE19000004.quest_desc: [
		"&7&lLORE:&f A festival works when the supplies reach the public square before the first bell, not when they remain in a private chest."
		"&e&lOBJECTIVE:&f Submit 1 Bevel for 16 Firework Rockets and 8 Lanterns."
		"&9&lUTILITY TAGS:&f [ROUTE] [DELIVERY] [PUBLIC DESTINATION]"
		"&a&lSTANDARD:&f Name the event route, public destination, delivery owner, and safe handoff point before claiming the team cache."
	]
	quest.7A11C0DE19000004.quest_subtitle: "Fireworks and lanterns delivered to a named public event route."
	quest.7A11C0DE19000004.title: "&e[DELIVERY] FESTIVAL CACHE — 1 BEVEL"
	task.7A11C0DE19100029.title: "Submit 1 Bevel"
	reward.7A11C0DE1920002A.title: "Sixteen Festival Rockets"
	reward.7A11C0DE1920002B.title: "Eight Event Lanterns"
	quest.7A11C0DE19000005.quest_desc: [
		"&7Lore:&f A courier can deliver a repair crate, but only builders can make a public machine or bridge trustworthy again. Nessa leaves the crate at the agreed worksite."
		"&fObjective:&f Submit 1 Bevel for four Super Glue and thirty-two Scaffolding."
		"&fStandard:&f Record which public work received the cache and leave the repaired access usable."
	]
	quest.7A11C0DE19000005.quest_subtitle: "A repair cache for shared machines, bridges, and temporary access."
	quest.7A11C0DE19000005.title: "&aREPAIR REQUISITION — 1 BEVEL"
	task.7A11C0DE19100033.title: "Submit 1 Bevel"
	reward.7A11C0DE19200034.title: "Four Super Glue"
	reward.7A11C0DE19200035.title: "Thirty-Two Scaffolding"
	quest.7A11C0DE19000006.quest_desc: [
		"&4&lLORE:&f The first welcome after Greybridge is deliberately ordinary: a guest needs a findable room, a readable promise, and enough light to leave safely."
		"&e&lOBJECTIVE:&f Submit 1 Bevel for 8 Books and 8 Lanterns."
		"&9&lUTILITY TAGS:&f [ROUTE] [DELIVERY] [PUBLIC DESTINATION]"
		"&a&lSTANDARD:&f Name the public hall, guesthouse, archive, or refuge, then record the delivery owner and the route a visitor can follow to the handoff."
	]
	quest.7A11C0DE19000006.quest_subtitle: "Books and lanterns for a shared guest space or civic hall."
	quest.7A11C0DE19000006.title: "&4[PUBLIC DESTINATION] HOSPITALITY CACHE — 1 BEVEL"
	task.7A11C0DE1910003D.title: "Submit 1 Bevel"
	reward.7A11C0DE1920003E.title: "Eight Guest Books"
	reward.7A11C0DE1920003F.title: "Eight Guest Lanterns"
	quest.7A11C0DE19000007.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&f&lTRUST DISPATCH"
		""
		"&7&lLORE:&f Nessa Quill keeps a spare courier line for civic problems that have a place to begin. The dispatch must concern the island being built now, not a required return to Greybridge."
		"&e&lOBJECTIVE:&f File one short dispatch naming a real in-world location and the concrete problem found there."
		"&e&lACTION:&f State one useful action another player can take next session, then name the owner responsible for receiving or closing the dispatch."
		"&a&lSTANDARD:&f A trust checkmark is enough: the entry is specific, findable, and actionable. This renews every 604800 seconds and grants exactly 1 team Bevel; it consumes no Bevel."
	]
	quest.7A11C0DE19000007.quest_subtitle: "One real location, one problem, one action, one owner — exactly one team Bevel weekly."
	quest.7A11C0DE19000007.title: "&f&lFILE A CIVIC DISPATCH"
	task.7A11C0DE19100047.title: "I Added One Actionable Rumour"
	quest.7A11C0DE19000009.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&e&lPUBLIC DESTINATION FILE"
		""
		"&7&lLORE:&f Nessa will carry one pressure forward, but she will not invent a destination for people who have already moved on. The old Greybridge failure is context, not a live-world prerequisite."
		"&e&lOBJECTIVE:&f Record one unresolved pressure, its public destination, stakeholders, evidence, and the practical route by which players can inspect it."
		"&a&lSTANDARD:&f Add one concrete future action and a named owner or steward; keep the hook useful without inventing a required location."
	]
	quest.7A11C0DE19000009.quest_subtitle: "Leave a public destination, stakeholders, and a reason to return."
	quest.7A11C0DE19000009.title: "&e[ROUTE] LEAVE A SEASON TWO PRESSURE"
	task.7A11C0DE1910005B.title: "We Recorded One Evidence-Based Season Two Hook"
	reward.7A11C0DE1920005C.title: "Choose a Season Two Hook Supply"
	// Supplemental titles for the charter, route and specialty rewards/tasks.
	reward.7A11C0DE10200011.title: "Eight Headquarters Scaffolding"
	reward.7A11C0DE10200012.title: "Eight Festival Rockets"
	reward.7A11C0DE10200013.title: "Four Bottles of Blood"
	quest.7A11C0DE11000006.title: "&eCHOOSE YOUR PERSONAL STARTER KIT"
	quest.7A11C0DE11000006.quest_subtitle: "Choose a way to be useful without closing the other doors."
	quest.7A11C0DE11000006.quest_desc: [
		"&7Lore:&f Nessa Quill sets six practical starter kits beside the welcome point. Each is a first contribution, not a permanent profession or locked class."
		"&fObjective:&f Preview the exact kit contents, then choose one:"
		"&f• Builder — 8 minecraft:scaffolding"
		"&f• Engineer — 1 create:goggles"
		"&f• Pathfinder — 1 minecraft:spyglass"
		"&f• Keeper — 4 minecraft:lantern"
		"&f• Arcanist — 2 irons_spellbooks:arcane_essence"
		"&f• Archivist — 2 minecraft:book"
		"&fStandard:&f Pick one kit after the welcome point is complete. Nothing prevents exploring the other specialties later."
	]
