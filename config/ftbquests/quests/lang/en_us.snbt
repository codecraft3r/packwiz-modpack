	// VvH depth expansion — House of Night
	quest.7A11C0DE12010101.quest_desc: [
		"&4&lLORE — A ROOM THAT ANSWERS"
		"&fNessa's list names people who needed a door, not a sermon. Improve the shared refuge so a guest can sleep, put things down, and find the way out after sunset."
		""
		"&eOBJECTIVE&f Improve the House refuge with a visible entrance, guest space, labelled emergency storage, and clear lighting."
		"&7BUILD STANDARD&f The space is public, usable, and safe without requiring faction allegiance."
		"&6DECISION&f Keep the supplies anonymous or add the first named guest to Nessa's surviving list. The choice changes the House's record, not the guest's access."
	]
	quest.7A11C0DE12010101.quest_subtitle: "Route · Team-friendly"
	quest.7A11C0DE12010101.title: "[WORLD] OPEN THE REFUGE"
	task.7A11C0DE12110101.title: "REVIEW: Public refuge, guest space, supplies, and safe lighting"
	reward.7A11C0DE12210101.title: "Choose One House Utility"
	quest.7A11C0DE12010102.quest_desc: [
		"&4&lLORE — THE HOUSE RULE IN RED INK"
		"&fMirelle knows a rule can protect a guest—or protect the steward from admitting uncertainty."
		"&fWrite one rule that permits shelter without allegiance, and one inheritance question the House still cannot answer."
		""
		"&eOBJECTIVE&f Place a book at the House archive or lectern and record both lines."
		"&7BUILD STANDARD&f The rule is readable and the unanswered question remains open rather than being presented as settled history."
	]
	quest.7A11C0DE12010102.quest_subtitle: "Advanced · Solo-friendly"
	quest.7A11C0DE12010102.title: "[CHARTER] WRITE THE HOUSE RULE"
	task.7A11C0DE12110102.title: "Carry a Book for the House Archive"
	task.7A11C0DE12110103.title: "REVIEW: Guest rule and inheritance question recorded"
	reward.7A11C0DE12210102.title: "Choose One House Utility"
	quest.7A11C0DE12010103.quest_desc: [
		"&4&lLORE — THE UNCLAIMED CUP"
		"&fThe first welcome after Greybridge is deliberately small. Blood is treated as memory and responsibility, not a badge."
		"&fNessa's list is evidence of people carried through danger, not a claim on those who come next."
		""
		"&eOBJECTIVE&f Prepare a Blood Bottle and host a bloodless welcome for a guest who is not required to be a vampire or Blood-school user."
		"&7BUILD STANDARD&f Show the shelter, the exit, and the supplies that may be used without a promise of allegiance."
		"&6CONSEQUENCE&f Mirelle must choose whether to record the guest by name or preserve their anonymity. Honour the choice in the House ledger."
	]
	quest.7A11C0DE12010103.quest_subtitle: "Workshop · Team-friendly"
	quest.7A11C0DE12010103.title: "[CHARTER] SERVE THE CUP"
	task.7A11C0DE12110104.title: "Show a Blood Bottle"
	task.7A11C0DE12110105.title: "REVIEW: Bloodless welcome offers shelter, exit, and no obligation"
	reward.7A11C0DE12210103.title: "Choose One House Utility"
	quest.7A11C0DE13000101.quest_desc: [
		"&6Lore:&f The watchhouse has a roof now. That is not the same thing as having a refuge."
		"&eObjective:&f Add eight placed lanterns and one visible public-service feature: labelled medicine, route notices, a guest bed, or a safe handoff point."
		"&aBuild Standard:&f A tired stranger can understand what the room is for and where to go next."
		"&7[SUITABLE: WORLD / REFUGE REFIT]"
	]
	quest.7A11C0DE13000101.quest_subtitle: "[WORLD] Make the refuge legible after dark."
	quest.7A11C0DE13000101.title: "[WORLD] &a&lREFIT THE WATCHHOUSE"
	task.7A11C0DE13100101.title: "Supply 8 Lanterns"
	task.7A11C0DE13100102.title: "REVIEW: Public-Service Feature Is Findable"
	reward.7A11C0DE13200101.title: "Choose One Lantern Utility Cache"
	quest.7A11C0DE13000102.quest_desc: [
		"&6Lore:&f A Holy Rune is not a medal. It is a promise that the room will still help someone who arrives frightened, injured, or unable to explain what happened."
		"&eObjective:&f Install one Holy Rune in one of three accepted public examples: a public ward, medical station, or shelter desk, and demonstrate its safe use."
		"&aBuild Standard:&f Use one of three accepted public examples—public ward, medical station, or shelter desk. Rune inspection is non-consuming; explain the visitor's next step."
		"&7[SUITABLE: PROGRESSION / PUBLIC CARE]"
	]
	quest.7A11C0DE13000102.quest_subtitle: "[PROGRESSION] Turn protection into a practiced service."
	quest.7A11C0DE13000102.title: "[PROGRESSION] &e&lCONSECRATE THE REFUGE"
	task.7A11C0DE13100103.title: "Supply 1 Holy Rune"
	task.7A11C0DE13100104.title: "REVIEW: Holy Station Demonstrated"
	reward.7A11C0DE13200102.title: "Choose One Consecrated Utility Cache"
	quest.7A11C0DE13000103.quest_desc: [
		"&6Lore:&f Quill's record says the refuge failed because no one outside the Order knew the handoff. Rook has stopped arguing with that line."
		"&eObjective:&f Invite someone outside the Order to use or review the refuge service, then record one practical handoff or improvement."
		"&aBuild Standard:&f The service works across faction lines and names who restocks, guides, or repairs it."
		"&7[SUITABLE: PROGRESSION / PUBLIC HANDOFF]"
	]
	quest.7A11C0DE13000103.quest_subtitle: "[PROGRESSION] Let the refuge work across faction lines."
	quest.7A11C0DE13000103.title: "[PROGRESSION] &b&lKEEP A TREATY LIGHT"
	task.7A11C0DE13100105.title: "Outside-Order Player Reviews or Uses the Service"
	task.7A11C0DE13100106.title: "REVIEW: Handoff or Improvement Recorded"
	reward.7A11C0DE13200103.title: "Choose One Treaty Utility Cache"
	quest.7A11C0DE15000101.quest_desc: [
	  "&6Lore:&f A craft becomes communal only when its next operator can find the instructions and the first honest failure. Leave one key in the settlement after the three-hands review."
	  "&fObjective:&7 Carry 1 Writable Book for inspection; it is not consumed. Leave the method, its result, and one failure or maintenance warning in the settlement."
	  "&fStandard:&7 Another player may sign the handoff; solo players sign it themselves and name the next test."
	]
	quest.7A11C0DE15000101.quest_subtitle: "Post-capstone handoff · leave one method ready"
	quest.7A11C0DE15000101.title: "&fPASS THE KEY"
	task.7A11C0DE15100101.title: "REVIEW: Another Player Can Repeat One Shared Service"
	reward.7A11C0DE15210101.title: "Choose a Handoff Supply"
	task.7A11C0DE15100102.title: "Carry 1 Writable Book for inspection (not consumed)"
	quest.7A11C0DE18000102.quest_desc: ["&f&lLORE" "&fNessa's final note leaves the two bell accounts side by side. The fair is over; the disagreement is now part of the island's usable history." "" "&e&lOBJECTIVE" "&fPlace the fair record and one genuine future hook in the public archive, then leave a writable page or clearly marked place for the next entry." "" "&9&lSUITABILITY" "&fSolo: findability audit | Group: announce the archive | Build: public record wall or writable archive." "" "&a&lEVENT STANDARD" "&fFor a group, announce where the record lives. For a solo audit, verify that a new player can find and understand it without an oral briefing."]
	quest.7A11C0DE18000102.quest_subtitle: "[EVENT] Put the final record somewhere the next season can find it."
	quest.7A11C0DE18000102.title: "[EVENT] &fARCHIVE AFTERMATH"
	task.7A11C0DE18100102.title: "File the Fair's Final Record"
	task.7A11C0DE18100103.title: "REVIEW: Record One Contradiction, Success, and Future Promise"
	reward.7A11C0DE18210102.title: "Choose an Archive Aftermath Supply"

	// VvH depth expansion — post-season sinks
	quest.7A11C0DE19000101.quest_desc: [
		"&a&lLORE:&f A construction crate matters only when it reaches the public work that needs it and remains legible after the builder leaves."
		"&e&lOBJECTIVE:&f Submit 2 Bevels for 32 Stone Bricks, 16 Scaffolding, and 8 Andesite Alloy."
		"&9&lUTILITY TAGS:&f [DELIVERY] [PUBLIC DESTINATION]"
		"&a&lSTANDARD:&f Name the shared build, delivery route, handoff owner, and the public use the completed crate supports."
	]
	quest.7A11C0DE19000101.quest_subtitle: "A modest build delivery for a shared civic work."
	quest.7A11C0DE19000101.title: "&a[PUBLIC DESTINATION] CONSTRUCTION CRATE — 2 BEVELS"
