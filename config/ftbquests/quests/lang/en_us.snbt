	reward.7A11C0DE19200102.title: "Sixteen Construction Scaffolding"
	reward.7A11C0DE19200103.title: "Eight Andesite Alloy"
	quest.7A11C0DE19000102.quest_desc: [
		"&d&lLORE:&f Research belongs in a place another player can find, inspect, and continue; the courier records the handoff instead of promising power."
		"&e&lOBJECTIVE:&f Submit 2 Bevels for 4 Arcane Essences, 2 Blank Runes, and 8 Amethyst Shards."
		"&9&lUTILITY TAGS:&f [ROUTE] [DELIVERY] [PUBLIC DESTINATION]"
		"&a&lSTANDARD:&f Name the public study point, delivery route, handoff owner, and safe boundary for the neutral research cache."
	]
	quest.7A11C0DE19000102.quest_subtitle: "Low-tier research supplies delivered to a named public study point."
	quest.7A11C0DE19000102.title: "&d[ROUTE] NEUTRAL ARCANE RESEARCH KIT — 2 BEVELS"
