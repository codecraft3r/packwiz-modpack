	reward.7A11C0DEF0030002.title: "Nature's Compass"
	reward.7A11C0DEF0030003.title: "Sixteen Lanterns"
	reward.7A11C0DEF0030004.title: "Thirty-Two Rails"

	chapter.7A11C0DE10000000.title: "VvH 00 · The Island Charter"
	quest.7A11C0DE10000001.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lTHE ISLAND NEEDS A MEMORY"
		""
		"&fThe server usually dies when progression finishes before the world becomes worth remembering."
		"&fSeason One reverses that with useful places, ridiculous rivalries, faction identity, public works, and records of what actually happened."
		""
		"&eRead the three reference clauses around this page, then sign the short charter below.&f They separate real hard protections from rules that only work because friends agree to honor them."
		""
		"&8Top gear is an ending. Municipal drama is renewable."
	]
	quest.7A11C0DE10000001.quest_subtitle: "Two minutes now; fewer arguments at 1:30 a.m."
	quest.7A11C0DE10000001.title: "&6&lOPEN THE ISLAND CHARTER"
	task.7A11C0DE10100001.title: "Open the Charter"
	quest.7A11C0DE10000003.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&a&lBUILD WHERE THE WORLD REMEMBERS"
		""
		"&fHomes, faction halls, markets, roads, memorials, public machines, and lore sites belong only on land the host has explicitly confirmed permanent."
		"&fAny announced reset zone is an expedition site, not a place for irreplaceable work. Claims are hard boundaries only where the live FTB Chunks configuration really enforces them."
		""
		"&cNo prank, theft, faction stunt, or contract overrides another team's protected claim or explicit consent."
		""
		"&8If the reset eats your cathedral, the cathedral was camping."
	]
	quest.7A11C0DE10000003.quest_subtitle: "Permanent work needs a boundary that actually means something."
	quest.7A11C0DE10000003.title: "&aLAND, CLAIMS, AND RESET ZONES"
	task.7A11C0DE10100003.title: "I Know the Permanent-Land and Claim Rule"
	quest.7A11C0DE10000005.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lTHE FUNNY WAR CLAUSE"
		""
		"&fVampires and Hunters may compete through banners, mascots, markets, races, scavenger hunts, public challenges, expeditions, propaganda, cooking, architecture, and reversible wilderness mischief."
		"&fNeutrals may trade, mediate, scout, judge, rescue, courier, host, or sell services to either side without becoming a consolation faction."
		""
		"&cNo claim intrusion, theft, spawn camping, targeted harassment, irreversible sabotage, or destruction wearing a comedy moustache."
		"&fCombat is a scheduled opt-in event only, with a host, backup, stop condition, protected noncombatants, and rebuild plan. Winning never grants progression power."
		""
		"&8A prank with a cleanup crew is a bit. A crater is an incident."
	]
	quest.7A11C0DE10000005.quest_subtitle: "Make stories, not support tickets."
	quest.7A11C0DE10000005.title: "&dRIVALRY, NEUTRALS, AND OPTIONAL COMBAT"
	task.7A11C0DE10100005.title: "I Accept the Rivalry and Optional-Combat Boundary"
	quest.7A11C0DE10000006.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&6&lONE BODY, ONE PARTY, TWO KINDS OF ALLEGIANCE"
		""
		"&fVampirism now provides real Vampire and Hunter factions. FTB Teams provides shared quest progress and FTB Chunks ownership. Season One uses both, but it does not automatically synchronize them."
		""
		"&eA Vampirism advancement records that an event happened; it is not a live faction-state detector forever."
		"&fBefore a faction team claims shared foundation supplies, one teammate or the host confirms that the team is presently aligned with that faction."
		"&fAsk the host before joining, leaving, or switching an FTB party. Claims, storage, contracts, and quest history must be checked rather than guessed."
		""
		"&8The bureaucracy has developed fangs."
	]
	quest.7A11C0DE10000006.quest_subtitle: "Two faction systems exist. Do not pretend they are the same database."
	quest.7A11C0DE10000006.title: "&6VAMPIRISM, FTB TEAMS, AND SWITCHING"
	task.7A11C0DE10100006.title: "I Understand Vampirism Faction vs FTB Team State"
	quest.7A11C0DE10000008.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lTHE FOUR-LINE VERSION"
		""
		"&f1. Build irreplaceable work only on confirmed permanent land."
		"&f2. Claims and consent outrank rivalry, contracts, and bits."
		"&f3. Combat is optional, scheduled, supervised, and reversible."
		"&f4. Vampirism faction state and FTB team state are separate; switches need a quick host review."
		""
		"&eClick to sign.&f The reference clauses stay visible whenever somebody begins a sentence with 'technically'."
		""
		"&6Starter nudge:&f one Compass and eight Torches. Enough to leave spawn with a plan; not enough to delete the opening game."
	]
	quest.7A11C0DE10000008.quest_subtitle: "Four boundaries, one signature, useful travel supplies."
	quest.7A11C0DE10000008.title: "&6&lSIGN THE CHARTER"
	task.7A11C0DE10100008.title: "Sign the Island Charter"
	reward.7A11C0DE10200001.title: "Field Charter"
	reward.7A11C0DE10200002.title: "Personal Compass"
	reward.7A11C0DE10200003.title: "Eight Travel Torches"

	chapter.7A11C0DE11000000.title: "VvH 01 · Three Invitations"
	quest.7A11C0DE11000001.quest_desc: [
		"{image:minecraft:textures/item/compass_16.png width:48 height:48 align:center}"
		"&6&lTHREE LEGITIMATE WAYS TO BELONG"
		""
		"&4Vampires&f gain a real supernatural progression and are asked to turn that identity into hospitality, ritual spaces, night infrastructure, and civic obligations."
		"&bHunters&f gain their own real progression and are asked to turn vigilance into safe roads, public knowledge, workshops, and reliable refuge."
		"&aNeutrals&f remain human/non-aligned and become the connective tissue: trade, contracts, mapping, MCA civic life, rescue, logistics, and arbitration."
		""
		"&eNothing here is permanent.&f Switching is allowed, but it creates social and claim bookkeeping. Pick the role you actually want to play this week, not the reward you think is numerically best."
		""
		"&8The Atlas has stopped pretending the word 'faction' is metaphorical."
	]
	quest.7A11C0DE11000001.quest_subtitle: "Choose what kind of problem you want to become useful at."
	quest.7A11C0DE11000001.title: "&6&lREAD THE THREE INVITATIONS"
	task.7A11C0DE11100001.title: "Read All Three Invitations"
	quest.7A11C0DE11000002.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&4&lTHE HOUSE OF NIGHT"
		""
		"&fComplete Vampirism's &eBecome a Vampire&f advancement, then click the second task after your current faction choice and intended FTB team are clear to at least one other player or the host."
		""
		"&7The advancement is historical evidence, not a permanent live-state lock. If you later cure/switch, the old page remains part of your story rather than becoming a loophole for fresh foundation caches."
		""
		"&8Please file all immortality paperwork before sunrise."
	]
	quest.7A11C0DE11000002.quest_subtitle: "Become a Vampire, then register the choice socially."
	quest.7A11C0DE11000002.title: "&4&lTAKE THE CRIMSON INVITATION"
	task.7A11C0DE11100015.title: "Become a Vampire"
	task.7A11C0DE11100016.title: "Our Current Allegiance and FTB Team Are Clear"
	reward.7A11C0DE11200017.title: "Crimson Invitation"
	quest.7A11C0DE11000003.quest_desc: [
		"{image:vampirism:textures/item/garlic.png width:48 height:48 align:center}"
		"&b&lTHE LANTERN ORDER"
		""
		"&fComplete Vampirism's &eBecome a Hunter&f advancement, then click the second task after your current faction choice and intended FTB team are clear to at least one other player or the host."
		""
		"&7The advancement records that you joined at least once. Later betrayal/switching does not erase history, so shared caches still use peer/host confirmation of current allegiance."
		""
		"&8The official uniform is 'prepared'. The cape remains under committee review."
	]
	quest.7A11C0DE11000003.quest_subtitle: "Become a Hunter, then register the choice socially."
	quest.7A11C0DE11000003.title: "&b&lTAKE THE LANTERN OATH"
	task.7A11C0DE1110001F.title: "Become a Hunter"
	task.7A11C0DE11100020.title: "Our Current Allegiance and FTB Team Are Clear"
	reward.7A11C0DE11200021.title: "Lantern Oath"
	quest.7A11C0DE11000004.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&a&lTHE FREE COMPANIES"
		""
		"&fRemain outside Vampire and Hunter alignment for now. Name one service you want to be known for: courier work, maps, market brokerage, MCA diplomacy, rescue, hospitality, construction, intelligence, or event hosting."
		""
		"&eClick after another player knows what service you offer.&f Neutrality is a playable civic role with its own foundation chapter, not a beige skip button."
		""
		"&8Somebody has to invoice the supernatural."
	]
	quest.7A11C0DE11000004.quest_subtitle: "Stay neutral on purpose, not by forgetting to choose."
	quest.7A11C0DE11000004.title: "&a&lSIGN THE FREE COMPANY REGISTER"
	task.7A11C0DE11100029.title: "I Registered a Neutral Service With Another Player"
	reward.7A11C0DE1120002B.title: "Free Company Writ"
	quest.7A11C0DE11000005.quest_desc: [
		"{image:minecraft:textures/item/spyglass.png width:48 height:48 align:center}"
		"&e&lONE ROLE, ZERO CLASS LOCKS"
		""
		"&fClaim one cosmetic Trade Lens: Builder, Engineer, Pathfinder, Keeper, Arcanist, or Archivist. It grants no stats and does not restrict later quests."
		""
		"&7The purpose is social legibility. When a project stalls, people should have a rough idea who enjoys fixing which kind of problem."
		""
		"&8Multiclassing is permitted because this is literally paper."
	]
	quest.7A11C0DE11000005.quest_subtitle: "Faction answers who you stand with; this answers how you help."
	quest.7A11C0DE11000005.title: "&eCHOOSE YOUR PERSONAL TRADE LENS"
	task.7A11C0DE11100033.title: "I Know What Kind of Work I Want First"
	reward.7A11C0DE11200034.title: "Choose a Personal Trade Lens"

	chapter.7A11C0DE12000000.title: "VvH 02 · House of Night"
	quest.7A11C0DE12000001.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK, NOT A TECH TREE"
		""
		"&fComplete any &e5 of 7&f foundation works. Every option leaves a useful place, supply, route, or institution behind; none exists merely to make an inventory number go up."
		""
		"&eShared-cache rule:&f before claiming the foundation cache, one teammate or the host confirms the FTB team presently represents this faction/company."
		"&fHistorical allegiance achievements do not entitle a switched team to duplicate supplies."
		""
		"&7Use the five-part creative rubric when a project says REVIEW: function, access, safety, story, maintenance. Two-player peer review or one host review passes it."
	]
	quest.7A11C0DE12000001.quest_subtitle: "Real vampire progression, followed by civic consequences."
	quest.7A11C0DE12000001.title: "&4&lFOUND THE HOUSE OF NIGHT"
	task.7A11C0DE1210000B.title: "At Least One Teammate Has Become a Vampire"
	task.7A11C0DE1210000C.title: "Current Vampire Alignment Confirmed for This FTB Team"
	quest.7A11C0DE12000002.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 1"
		""
		"&fPlace at least one functional coffin in an accessible shared room, plus ordinary storage or seating for visitors. The point is a headquarters people return to, not a lone coffin abandoned in a cave."
		"&7REVIEW checks function, access, safety, story, and maintenance."
	]
	quest.7A11C0DE12000002.quest_subtitle: "REVIEW · bedrooms that make the faction's actual needs visible."
	quest.7A11C0DE12000002.title: "&4BUILD THE COMMON COFFIN ROOM"
	task.7A11C0DE12100015.title: "Carry a Red Coffin"
	task.7A11C0DE12100016.title: "REVIEW: The House Has a Shared Sleeping/Recovery Space"
	quest.7A11C0DE12000003.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 2"
		""
		"&fObtain an Altar of Inspiration and install it in a deliberate chamber with a safe approach and a sign/book explaining the room."
		"&fLeave enough space that teammates are not clipping through furniture during progression."
		"&8Ancient evil remains subject to fire code."
	]
	quest.7A11C0DE12000003.quest_subtitle: "Make the first faction ritual object part of a place, not a lawn ornament."
	quest.7A11C0DE12000003.title: "&4RAISE AN ALTAR CHAMBER"
	task.7A11C0DE1210001F.title: "Carry an Altar of Inspiration"
	task.7A11C0DE12100020.title: "REVIEW: The Altar Has a Safe, Named Chamber"
	quest.7A11C0DE12000004.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 3"
		""
		"&fCarry four Blood Bottles and establish a labelled shared pantry or processing corner. Do not consume the bottles for the quest; the task checks possession only."
		"&fLeave a written restock rule so a late player knows whether supplies are communal, reserved, or trade stock."
	]
	quest.7A11C0DE12000004.quest_subtitle: "A faction resource should have a home before it becomes chest soup."
	quest.7A11C0DE12000004.title: "&4STOCK A BLOOD PANTRY"
	task.7A11C0DE12100029.title: "Carry 4 Blood Bottles"
	task.7A11C0DE1210002A.title: "REVIEW: A Labelled Shared Blood Pantry Exists"
	quest.7A11C0DE12000005.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 4"
		""
		"&fUse Vampire's Delight or ordinary food infrastructure to make a small kitchen/serving area. Carry one Blood Pie as proof you touched the pack's vampire-food loop."
		"&fThe room passes when a guest can arrive, understand what is communal, and leave without raiding a progression chest."
	]
	quest.7A11C0DE12000005.quest_subtitle: "Hospitality is faction infrastructure too."
	quest.7A11C0DE12000005.title: "&4OPEN THE NIGHT KITCHEN"
	task.7A11C0DE12100033.title: "Carry a Blood Pie"
	task.7A11C0DE12100034.title: "REVIEW: The Night Kitchen Can Host a Visitor"
	quest.7A11C0DE12000006.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 5"
		""
		"&fCreate or adopt a signed route between the House and one public destination: spawn, market, port, workshop, road, archive, or neutral office. Make hazards visible without flooding the whole island with random torches."
		"&7A route is infrastructure when somebody else can follow it alone."
	]
	quest.7A11C0DE12000006.quest_subtitle: "The House should improve travel, not merely occupy a basement."
	quest.7A11C0DE12000006.title: "&4MARK A SAFE NIGHT ROUTE"
	task.7A11C0DE1210003D.title: "REVIEW: A Signed Night Route Connects Two Useful Places"
	quest.7A11C0DE12000007.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 6"
		""
		"&fInvite at least one player who is not required to be a Vampire. Give them a tour, meal, trade, ceremony, archive reading, or ridiculous local custom."
		"&fNo PvP or feeding is required. The social event itself is the objective."
	]
	quest.7A11C0DE12000007.quest_subtitle: "Show that faction identity can create a scene without creating a corpse."
	quest.7A11C0DE12000007.title: "&4HOST A BLOODLESS VISIT"
	task.7A11C0DE12100047.title: "Two Players Visited the House for a Tour, Meal, Trade, or Ceremony"
	quest.7A11C0DE12000008.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&4&lFOUNDATION WORK 7"
		""
		"&fBuild or adopt one Create machine that solves a real shared problem: processing, doors, storage movement, kitchen support, transport loading, or spectacle with an actual use."
		"&fCarry a Mechanical Press as a modest objective proof; the reviewed machine itself may use any appropriate Create components."
	]
	quest.7A11C0DE12000008.quest_subtitle: "Immortality still benefits from logistics."
	quest.7A11C0DE12000008.title: "&4INSTALL ONE USEFUL MACHINE"
	task.7A11C0DE12100051.title: "Carry a Mechanical Press"
	task.7A11C0DE12100052.title: "REVIEW: The Machine Serves a Shared Function"
	quest.7A11C0DE1200000A.quest_desc: [
		"{image:vampirism:textures/item/vampire_fang.png width:48 height:48 align:center}"
		"&4&lA PLACE WITH OBLIGATIONS"
		""
		"&fFinish any five foundation works, then click the review task after the team confirms the current allegiance/company identity, names the headquarters, and records one maintenance owner or rotation."
		""
		"&eReward philosophy:&f each foundation gets the same horizontal construction cache: scaffolding and Super Glue. Faction flavor lives in what you built, not in getting a numerically better loot table."
		""
		"&7The keepsake is historical. Switching later does not make it a coupon."
	]
	quest.7A11C0DE1200000A.quest_subtitle: "Five useful works become a home people can actually rely on."
	quest.7A11C0DE1200000A.title: "&4&lCHARTER THE HOUSE OF NIGHT"
	task.7A11C0DE12100065.title: "Current Identity Confirmed; Headquarters Named; Maintenance Owner Recorded"
	reward.7A11C0DE12200066.title: "Foundation Charter"
	reward.7A11C0DE12200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE12200068.title: "Four Super Glue"

	chapter.7A11C0DE13000000.title: "VvH 03 · Lantern Order"
	quest.7A11C0DE13000001.quest_desc: [
		"{image:vampirism:textures/item/garlic.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK, NOT A TECH TREE"
		""
		"&fComplete any &e5 of 7&f foundation works. Every option leaves a useful place, supply, route, or institution behind; none exists merely to make an inventory number go up."
		""
		"&eShared-cache rule:&f before claiming the foundation cache, one teammate or the host confirms the FTB team presently represents this faction/company."
		"&fHistorical allegiance achievements do not entitle a switched team to duplicate supplies."
		""
		"&7Use the five-part creative rubric when a project says REVIEW: function, access, safety, story, maintenance. Two-player peer review or one host review passes it."
	]
	quest.7A11C0DE13000001.quest_subtitle: "Real hunter progression, followed by public responsibility."
	quest.7A11C0DE13000001.title: "&b&lFOUND THE LANTERN ORDER"
	task.7A11C0DE1310000B.title: "At Least One Teammate Has Become a Hunter"
	task.7A11C0DE1310000C.title: "Current Hunter Alignment Confirmed for This FTB Team"
	quest.7A11C0DE13000002.quest_desc: [
		"{image:vampirism:textures/item/garlic.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 1"
		""
		"&fBuild a small watchhouse, gatehouse, or civic room with public information: local hazards, routes, contacts, or shelter instructions. Private equipment can remain private; the public-facing service must be obvious."
		"&8A watchhouse with no information is just a suspicious shed."
	]
	quest.7A11C0DE13000002.quest_subtitle: "REVIEW · visible service before private arsenal."
	quest.7A11C0DE13000002.title: "&bBUILD THE PUBLIC WATCHHOUSE"
	task.7A11C0DE13100015.title: "REVIEW: The Watchhouse Has Public Information and a Safe Guest Area"
	quest.7A11C0DE13000003.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 2"
		""
		"&fObtain a Hunter Table and install it in a shared workshop with storage and enough room for somebody else to understand the station without excavating your bedroom."
		"&7This is progression infrastructure, not a requirement to sprint the hunter tech tree."
	]
	quest.7A11C0DE13000003.quest_subtitle: "Put the actual faction workstation somewhere teammates can use it."
	quest.7A11C0DE13000003.title: "&bESTABLISH THE HUNTER TABLE"
	task.7A11C0DE1310001F.title: "Carry a Hunter Table"
	task.7A11C0DE13100020.title: "REVIEW: The Hunter Table Is Installed in a Shared Workshop"
	quest.7A11C0DE13000004.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 3"
		""
		"&fCarry eight Garlic and establish a labelled field-supply reserve. It can also contain food, maps, lanterns, spare tools, or first-response supplies."
		"&fDo not consume the Garlic for the quest. The point is a maintained shared reserve."
	]
	quest.7A11C0DE13000004.quest_subtitle: "Preparedness is funnier when it has labels."
	quest.7A11C0DE13000004.title: "&bKEEP THE GARLIC RESERVE"
	task.7A11C0DE13100029.title: "Carry 8 Garlic"
	task.7A11C0DE1310002A.title: "REVIEW: A Labelled Shared Garlic/Field-Supply Reserve Exists"
	quest.7A11C0DE13000005.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 4"
		""
		"&fCarry four Stakes and make a tiny training or equipment area. It may be ceremonial or practical, but it needs a clear rule against using faction equipment as an excuse to harass unwilling players."
		"&7The quest does not require the hidden stake-kill advancement. Violence remains optional."
	]
	quest.7A11C0DE13000005.quest_subtitle: "Tools become culture when people know the safety rules."
	quest.7A11C0DE13000005.title: "&bASSEMBLE A STAKE DRILL KIT"
	task.7A11C0DE13100033.title: "Carry 4 Stakes"
	task.7A11C0DE13100034.title: "REVIEW: A Safe Training/Equipment Area Exists"
	quest.7A11C0DE13000006.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 5"
		""
		"&fObtain an Alchemical Cauldron and install it with labelled ingredient/storage space. The station should be usable without blocking a hallway or setting the meeting room on fire."
		"&8Chemistry is just potion-making wearing safety goggles."
	]
	quest.7A11C0DE13000006.quest_subtitle: "Make countermeasure tech legible to the team."
	quest.7A11C0DE13000006.title: "&bOPEN THE ALCHEMICAL BENCH"
	task.7A11C0DE1310003D.title: "Carry an Alchemical Cauldron"
	task.7A11C0DE1310003E.title: "REVIEW: The Cauldron Has a Safe Shared Work Area"
	quest.7A11C0DE13000007.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 6"
		""
		"&fCreate or adopt a readable route between the Order and one public destination. Mark turns, major hazards, and a safe fallback point rather than carpeting the island with torch spam."
		"&fA player unfamiliar with the route should be able to use it without voice chat."
	]
	quest.7A11C0DE13000007.quest_subtitle: "A Hunter faction earns trust by making retreat possible."
	quest.7A11C0DE13000007.title: "&bLIGHT A REFUGE ROUTE"
	task.7A11C0DE13100047.title: "REVIEW: A Signed, Lit Refuge Route Connects Two Useful Places"
	quest.7A11C0DE13000008.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&b&lFOUNDATION WORK 7"
		""
		"&fRun a short drill with another player: night escort, lost-player retrieval, route evacuation, Hordes shelter test, equipment demo, or emergency supply run."
		"&fNo combat is necessary. The output is one improvement to the route, instructions, or supplies discovered by the drill."
	]
	quest.7A11C0DE13000008.quest_subtitle: "Preparation without a victim."
	quest.7A11C0DE13000008.title: "&bRUN ONE CIVILIAN SAFETY DRILL"
	task.7A11C0DE13100051.title: "At Least Two Players Completed a Safety/Rescue Drill"
	quest.7A11C0DE1300000A.quest_desc: [
		"{image:vampirism:textures/item/garlic.png width:48 height:48 align:center}"
		"&b&lA PLACE WITH OBLIGATIONS"
		""
		"&fFinish any five foundation works, then click the review task after the team confirms the current allegiance/company identity, names the headquarters, and records one maintenance owner or rotation."
		""
		"&eReward philosophy:&f each foundation gets the same horizontal construction cache: scaffolding and Super Glue. Faction flavor lives in what you built, not in getting a numerically better loot table."
		""
		"&7The keepsake is historical. Switching later does not make it a coupon."
	]
	quest.7A11C0DE1300000A.quest_subtitle: "Five useful works become a home people can actually rely on."
	quest.7A11C0DE1300000A.title: "&b&lCHARTER THE LANTERN ORDER"
	task.7A11C0DE13100065.title: "Current Identity Confirmed; Headquarters Named; Maintenance Owner Recorded"
	reward.7A11C0DE13200066.title: "Foundation Charter"
	reward.7A11C0DE13200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE13200068.title: "Four Super Glue"

	chapter.7A11C0DE14000000.title: "VvH 04 · Free Companies"
	quest.7A11C0DE14000001.quest_desc: [
		"{image:poiesis:textures/questpics/vvh/free_company_writ.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK, NOT A TECH TREE"
		""
		"&fComplete any &e5 of 7&f foundation works. Every option leaves a useful place, supply, route, or institution behind; none exists merely to make an inventory number go up."
		""
		"&eShared-cache rule:&f before claiming the foundation cache, one teammate or the host confirms the FTB team presently represents this faction/company."
		"&fHistorical allegiance achievements do not entitle a switched team to duplicate supplies."
		""
		"&7Use the five-part creative rubric when a project says REVIEW: function, access, safety, story, maintenance. Two-player peer review or one host review passes it."
	]
	quest.7A11C0DE14000001.quest_subtitle: "Neutrality becomes valuable when it has services, routes, and a place to meet."
	quest.7A11C0DE14000001.title: "&a&lFOUND A FREE COMPANY"
	task.7A11C0DE1410000B.title: "Current Neutral/Independent Status Confirmed With Another Player"
	quest.7A11C0DE14000002.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 1"
		""
		"&fBuild a board, desk, book, or mailbox where players can request services. Include at least three examples such as courier, mapping, construction, mediation, rescue, market procurement, escort, or event staffing."
		"&fPrices may be items, favors, Bevels, or negotiated nonsense. Terms must be understandable before acceptance."
	]
	quest.7A11C0DE14000002.quest_subtitle: "REVIEW · one visible place where people can ask for help."
	quest.7A11C0DE14000002.title: "&aOPEN A CONTRACT BOARD"
	task.7A11C0DE14100015.title: "REVIEW: A Public Contract Board Has At Least 3 Clear Job Types"
	quest.7A11C0DE14000003.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 2"
		""
		"&fCarry a Filled Map and publish one named route between useful locations. Include at least one navigation aid: signs, map markers, road, landmark, or written directions."
		"&7Fast travel is optional; shared knowledge is the actual infrastructure."
	]
	quest.7A11C0DE14000003.quest_subtitle: "REVIEW · turn a trip into shared knowledge."
	quest.7A11C0DE14000003.title: "&aMARK A COURIER ROUTE"
	task.7A11C0DE1410001F.title: "Carry a Filled Map"
	task.7A11C0DE14100020.title: "REVIEW: A Named Courier Route Connects Two Useful Places"
	quest.7A11C0DE14000004.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 3"
		""
		"&fCreate a market stall, exchange counter, or service desk with a visible offer. At least one trade should be useful to both factions or to a late joiner."
		"&fDo not design a closed-loop arbitrage machine around quest rewards."
	]
	quest.7A11C0DE14000004.quest_subtitle: "REVIEW · trade should create meetings, not spreadsheets."
	quest.7A11C0DE14000004.title: "&aESTABLISH A MARKET STALL"
	task.7A11C0DE14100029.title: "REVIEW: A Stall or Counter Lists Goods/Services and Contact Terms"
	quest.7A11C0DE14000005.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 4"
		""
		"&fBuild a small guesthouse, embassy room, tavern corner, or waystation with seating/sleeping, food access, and a clearly neutral meeting area."
		"&fThe space should be useful when Vampire and Hunter players need to talk without standing in somebody's storage room."
	]
	quest.7A11C0DE14000005.quest_subtitle: "REVIEW · neutrality should be somewhere people can meet."
	quest.7A11C0DE14000005.title: "&aMAKE A GUESTHOUSE OR WAYSTATION"
	task.7A11C0DE14100033.title: "REVIEW: A Neutral Guest/Meeting Space Can Host 2 Players"
	quest.7A11C0DE14000006.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 5"
		""
		"&fUse books, signs, lecterns, or an archive chest to record at least three useful facts: contracts, route notes, faction agreements, public project owners, trade terms, or unresolved disputes."
		"&7The ledger is allowed to be funny. It is not allowed to be useless."
	]
	quest.7A11C0DE14000006.quest_subtitle: "REVIEW · record agreements before memory becomes fan fiction."
	quest.7A11C0DE14000006.title: "&aSTART THE CIVIC LEDGER"
	task.7A11C0DE1410003D.title: "REVIEW: A Shared Ledger Records At Least 3 Contracts, Places, or Decisions"
	quest.7A11C0DE14000007.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 6"
		""
		"&fUse Minecraft Comes Alive / Capitals, when available in the current world, to create one named civic connection: village liaison, household, public role, settlement story, ceremony, or negotiated relationship."
		"&fIf world conditions make MCA unavailable, the host may approve an equivalent player-run civic role instead."
	]
	quest.7A11C0DE14000007.quest_subtitle: "MCA is for people and places, not just furniture with dialogue boxes."
	quest.7A11C0DE14000007.title: "&aMAKE ONE MCA CIVIC CONNECTION"
	task.7A11C0DE14100047.title: "REVIEW: We Used MCA/Civic Play to Create One Named Relationship or Place"
	quest.7A11C0DE14000008.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&a&lFOUNDATION WORK 7"
		""
		"&fHelp resolve one real cross-player problem: lost gear retrieval, route confusion, disputed trade, transport failure, event scheduling, missing supplies, or a faction misunderstanding."
		"&fThe other player confirms completion. Manufactured arguments do not count; please do not optimize bureaucracy."
	]
	quest.7A11C0DE14000008.quest_subtitle: "Solve one problem nobody owns by default."
	quest.7A11C0DE14000008.title: "&aRUN A MEDIATION OR RESCUE"
	task.7A11C0DE14100051.title: "Another Player Confirms the Mediation, Rescue, or Logistics Help"
	quest.7A11C0DE1400000A.quest_desc: [
		"{image:poiesis:textures/questpics/vvh/free_company_writ.png width:48 height:48 align:center}"
		"&a&lA PLACE WITH OBLIGATIONS"
		""
		"&fFinish any five foundation works, then click the review task after the team confirms the current allegiance/company identity, names the headquarters, and records one maintenance owner or rotation."
		""
		"&eReward philosophy:&f each foundation gets the same horizontal construction cache: scaffolding and Super Glue. Faction flavor lives in what you built, not in getting a numerically better loot table."
		""
		"&7The keepsake is historical. Switching later does not make it a coupon."
	]
	quest.7A11C0DE1400000A.quest_subtitle: "Five useful works become a home people can actually rely on."
	quest.7A11C0DE1400000A.title: "&a&lCHARTER THE FREE COMPANY"
	task.7A11C0DE14100065.title: "Current Identity Confirmed; Headquarters Named; Maintenance Owner Recorded"
	reward.7A11C0DE14200066.title: "Foundation Charter"
	reward.7A11C0DE14200067.title: "Thirty-Two Scaffolding"
	reward.7A11C0DE14200068.title: "Four Super Glue"

	chapter.7A11C0DE15000000.title: "VvH 05 · The Work Each Hand Knows"
	quest.7A11C0DE15000001.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lSPECIALIZATION WITHOUT HOMEWORK"
		""
		"&fAfter any one foundation is established, complete any &e3 of 8&f contribution routes. They overlap ordinary play and are designed so a Neutral, Vampire, or Hunter can finish the chapter without changing faction."
		""
		"&7A route passes when it leaves behind something reusable: a machine, service, guide, relationship, supply system, route, or documented technique. Pure inventory flexing is not a contribution."
		""
		"&8The Atlas has discovered comparative advantage and is being unbearable about it."
	]
	quest.7A11C0DE15000001.quest_subtitle: "Complete any three routes. Let somebody else be good at the other five."
	quest.7A11C0DE15000001.title: "&6&lTHE WORK EACH HAND KNOWS"
	task.7A11C0DE15100001.title: "Read the Eight Contribution Routes"
	quest.7A11C0DE15000002.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fCarry eight Andesite Alloy, then build or improve a Create system used by at least one other player."
		"&fGood outputs include processing, loading, doors, elevators, workshop tooling, kitchen support, or moving spectacle that actually moves something useful."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000002.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000002.title: "&6ENGINEER — MAKE MOTION USEFUL"
	task.7A11C0DE15100015.title: "Carry 8 Andesite Alloy"
	task.7A11C0DE15100016.title: "REVIEW: A Create System Solves a Shared Problem"
	quest.7A11C0DE15000003.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fCarry eight Arcane Essence and publish one practical Iron's Spells guide, labelled station, sample kit, or demonstration another player can reproduce."
		"&fThe quest rewards teaching the system, not owning the rarest spell."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000003.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000003.title: "&dARCANIST — MAKE MAGIC TEACHABLE"
	task.7A11C0DE1510001F.title: "Carry 8 Arcane Essence"
	task.7A11C0DE15100020.title: "REVIEW: A Spell/Ingredient/Upgrade Tip Is Published"
	quest.7A11C0DE15000004.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fDocument or demonstrate one useful Vampirism mechanic, progression dependency, faction-specific workstation, safe countermeasure, or Vampire's Delight recipe."
		"&fA Neutral may complete this by interviewing/observing a faction player and publishing the result. No faction conversion is required."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000004.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000004.title: "&4FACTION SPECIALIST — TRANSLATE THE SUPERNATURAL"
	task.7A11C0DE15100029.title: "REVIEW: I Taught or Documented One Vampirism Mechanic for Someone Else"
	quest.7A11C0DE15000005.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fCarry one Create Propulsion Wing and contribute to an airframe, vehicle, dock, hangar, test stand, or transport prototype."
		"&fThe machine does not have to be a finished airship. A documented test that prevents the next person from repeating your crash counts."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000005.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000005.title: "&bAERONAUT — BUILD TOWARD A VEHICLE"
	task.7A11C0DE15100033.title: "Carry a Propulsion Wing"
	task.7A11C0DE15100034.title: "REVIEW: A Vehicle/Airframe Test or Dock Improvement Was Documented"
	quest.7A11C0DE15000006.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fCreate or clarify one real agreement: trade terms, MCA/civic relationship, faction access rule, public-project ownership, event schedule, or dispute resolution."
		"&fWrite the result somewhere participants can find later. Diplomacy without a record is just vibes with a meeting time."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000006.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000006.title: "&aDIPLOMAT — MAKE A RELATIONSHIP LEGIBLE"
	task.7A11C0DE1510003D.title: "Another Player Confirms a Trade, MCA, Faction, or Civic Agreement"
	quest.7A11C0DE15000007.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fUse Farmer's Delight, Vampire's Delight, or ordinary food to run a shared meal, pantry, travel ration station, or event table for at least two players."
		"&fVampire-specific and human-friendly options can coexist; the point is hospitality without forcing anybody's diet or faction."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000007.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000007.title: "&eQUARTERMASTER — FEED A GROUP"
	task.7A11C0DE15100047.title: "REVIEW: A Shared Meal or Supply Station Served At Least 2 Players"
	quest.7A11C0DE15000008.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fCarry a Filled Map and publish a route to a biome, structure, settlement, public work, faction hall, or expedition point."
		"&fInclude signs, landmarks, map notes, Via Romana roadwork, or written directions so another person can follow it alone."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000008.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000008.title: "&aPATHFINDER — TURN DISTANCE INTO A ROUTE"
	task.7A11C0DE15100051.title: "Carry a Filled Map"
	task.7A11C0DE15100052.title: "REVIEW: A New Route/Map Is Usable Without Voice Chat"
	quest.7A11C0DE15000009.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lLEAVE SOMETHING BEHIND"
		""
		"&fWrite down one failed machine, bad expedition, faction misunderstanding, Hordes incident, server bug workaround, or ridiculous accident and the lesson it produced."
		"&fThe archive should save the next player time or make the story worth retelling. Ideally both."
		""
		"&7Progress is personal within your current FTB quest team; reviewed output may be faction or server-wide."
	]
	quest.7A11C0DE15000009.quest_subtitle: "Personal contribution · useful output required."
	quest.7A11C0DE15000009.title: "&fARCHIVIST — PRESERVE ONE FAILURE"
	task.7A11C0DE1510005B.title: "REVIEW: A Failure, Fix, or Weird Event Was Archived With a Useful Lesson"
	quest.7A11C0DE1500000A.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&6&lBREADTH WITHOUT COMPLETIONISM"
		""
		"&fComplete any three contribution routes. You do not get a bonus for clearing all eight, because that would quietly turn choice into homework."
		""
		"&eClaim one practical favor:&f a small horizontal utility bundle. The strongest option shortens setup friction; none hands out faction rank, boss loot, rare gear, or a finished vehicle."
		""
		"&8Someone else is allowed to know things you don't. Horrifying."
	]
	quest.7A11C0DE1500000A.quest_subtitle: "Choose one practical favor after contributing in three different ways."
	quest.7A11C0DE1500000A.title: "&6&lTHREE HANDS' WORTH"
	task.7A11C0DE15100065.title: "Record Which Three Routes I Contributed"
	reward.7A11C0DE15200066.title: "Choose a Practical Contribution Favor"

	chapter.7A11C0DE16000000.title: "VvH 06 · The Island Remembers"
	quest.7A11C0DE16000001.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORKS ARE THE REAL ENDGAME"
		""
		"&fComplete any &e4 of 8&f projects. Each must be public or clearly shared, named, and maintainable. Projects may be new builds or substantial upgrades to something players already care about."
		""
		"&7REVIEW uses function, access, safety, story, maintenance. A beautiful object nobody can use is art; good. It is simply not this particular quest."
		""
		"&8The road to endgame is now literally a road."
	]
	quest.7A11C0DE16000001.quest_subtitle: "Complete any four public works. Build history into the commute."
	quest.7A11C0DE16000001.title: "&6&lTHE ISLAND REMEMBERS"
	task.7A11C0DE16100001.title: "Read the Public-Works Rubric"
	quest.7A11C0DE16000002.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fCreate or upgrade a road, rail, path, sign system, or Via Romana route linking at least three useful locations."
		"&fIt needs readable navigation and a maintenance owner or faction/company responsibility."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000002.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000002.title: "&eROAD OR WAYFINDING SPINE"
	task.7A11C0DE16100015.title: "REVIEW: A Named Route Links 3 Useful Places"
	quest.7A11C0DE16000003.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fBuild or improve a public market with at least three useful offers, contract categories, or service desks."
		"&fInclude neutral access and clear rules for faction goods rather than creating a private chest mall with a dramatic roof."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000003.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000003.title: "&6MARKET AND CONTRACT HALL"
	task.7A11C0DE1610001F.title: "REVIEW: A Public Market/Contract Space Has At Least 3 Active Uses"
	quest.7A11C0DE16000004.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fCreate a workshop where players can access at least two useful capabilities such as Create processing, repair/build tools, enchanting support, storage, or safe experiment space."
		"&fLabel what is public versus personal before somebody 'borrows' the important gear forever."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000004.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000004.title: "&6SHARED WORKSHOP"
	task.7A11C0DE16100029.title: "REVIEW: A Public Workshop Exposes At Least 2 Useful Capabilities"
	quest.7A11C0DE16000005.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fBuild or expand an archive, museum, memorial, map room, newspaper office, or gallery preserving at least five real facts, events, failures, places, or people from this world."
		"&fFuture players should be able to infer that things happened here before they logged in."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000005.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000005.title: "&fARCHIVE AND MEMORIAL"
	task.7A11C0DE16100033.title: "REVIEW: The Archive Preserves At Least 5 Real Server Facts/Stories"
	quest.7A11C0DE16000006.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fBuild a public kitchen or pantry that supports ordinary food plus faction-specific needs where practical. Farmer's Delight and Vampire's Delight both count."
		"&fPublish what is communal, what should be restocked, and who gets yelled at when the last ration disappears."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000006.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000006.title: "&aCOMMUNITY KITCHEN"
	task.7A11C0DE1610003D.title: "REVIEW: A Shared Kitchen/Pantry Supports Multiple Diets and Players"
	quest.7A11C0DE16000007.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fBuild or improve a dock, hangar, test field, landing marker, vehicle depot, or loading platform for Create Aeronautics/Propulsion play."
		"&fIt can precede a fully working craft. Infrastructure that makes future vehicles easier is already valuable."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000007.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000007.title: "&bAIRSHIP / VEHICLE PORT"
	task.7A11C0DE16100047.title: "REVIEW: A Dock, Hangar, Test Field, or Vehicle Station Is Publicly Usable"
	quest.7A11C0DE16000008.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fBuild a refuge, fallback room, alarm point, lit retreat route, or emergency-supply station useful during The Hordes or other world threats."
		"&fTest the plan with another player and fix at least one issue found during the drill."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000008.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000008.title: "&cHORDE REFUGE"
	task.7A11C0DE16100051.title: "REVIEW: A Refuge/Alarm Plan Was Tested With Another Player"
	quest.7A11C0DE16000009.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lPUBLIC WORK"
		""
		"&fCreate a meeting hall, public stage, council table, courtroom, chapel, tavern room, or outdoor forum and actually use it for one event."
		"&fA room becomes history when somebody can say what happened there."
		""
		"&eScope:&f the physical project is server-wide even though FTB Quests records completion in the reviewing team's progress container."
	]
	quest.7A11C0DE16000009.quest_subtitle: "Server-wide creative milestone · peer/host review."
	quest.7A11C0DE16000009.title: "&dMEETING HALL / PUBLIC STAGE"
	task.7A11C0DE1610005B.title: "REVIEW: The Space Hosted a Real Meeting, Ceremony, Performance, or Briefing"
	quest.7A11C0DE1600000B.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lTHE PLACE IS STARTING TO HAVE A PAST"
		""
		"&fFinish any four public works. Take one screenshot/map/book record of the finished set and place a copy in the archive or a public chest."
		""
		"&eTeam cache:&f lighting and scaffolding for maintenance. The reward funds upkeep rather than bypassing the next technology tier."
		""
		"&8Congratulations: you have invented municipal services in a game about punching trees."
	]
	quest.7A11C0DE1600000B.quest_subtitle: "Public work should still matter after everybody's inventory improves."
	quest.7A11C0DE1600000B.title: "&6&lFOUR THINGS THE ISLAND KEEPS"
	task.7A11C0DE1610006F.title: "Archive One Record of the Four Public Works"
	reward.7A11C0DE16200070.title: "Sixteen Maintenance Lanterns"
	reward.7A11C0DE16200071.title: "Thirty-Two Maintenance Scaffolding"
	reward.7A11C0DE16200072.title: "Civic Works Docket"

	chapter.7A11C0DE17000000.title: "VvH 07 · Rivalry Without Ruin"
	quest.7A11C0DE17000001.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lTHE OBJECTIVE IS A STORY SOMEBODY RETELLS"
		""
		"&fEvery challenge here is optional. Run any format that both sides understand, with a visible end condition and cleanup owner. Rewards are cosmetic/status or event supplies, never combat power."
		""
		"&cThe skirmish branch requires at least two noncombat rivalry activities first.&f If the factions cannot survive a mascot contest, they have not earned swords."
		""
		"&8Cold war, but the missiles are baked goods."
	]
	quest.7A11C0DE17000001.quest_subtitle: "Complete two noncombat formats before the skirmish even appears as a serious idea."
	quest.7A11C0DE17000001.title: "&d&lRIVALRY WITHOUT RUIN"
	task.7A11C0DE17100001.title: "Read the Safe-Rivalry Rules"
	quest.7A11C0DE17000002.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fEach participating side makes one reversible public propaganda piece, banner display, museum label, or dramatic accusation about the other."
		"&fNo placing inside protected claims without permission. Cleanup deadline required."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000002.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000002.title: "&dPROPAGANDA EXCHANGE"
	task.7A11C0DE17100015.title: "Both Sides Displayed a Reversible Poster/Banner/Exhibit"
	quest.7A11C0DE17000003.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fRun a themed food contest using Vampire's Delight, Farmer's Delight, garlic, blood-themed cuisine, or absurd neutral entries."
		"&fJudge presentation, story, taste-by-roleplay, logistics, or whatever criteria are agreed before the event. Nobody has to consume food their faction mechanics dislike."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000003.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000003.title: "&eBLOOD VS GARLIC COOK-OFF"
	task.7A11C0DE1710001F.title: "At Least 3 Players Judged or Attended the Cook-Off"
	quest.7A11C0DE17000004.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fPlace a short clue chain in public or explicitly permitted wilderness space. Finish with a harmless trophy, message, location reveal, or public project tour."
		"&fArchive the best clue afterward; remove anything that became litter."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000004.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000004.title: "&aSCAVENGER HUNT"
	task.7A11C0DE17100029.title: "A Hunt Was Completed and Every Clue Was Removed/Archived"
	quest.7A11C0DE17000005.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fRun a foot, road, rail, boat, glider, or vehicle courier race. Publish the route, allowed transport, start/end, and one safety rule before launching."
		"&fReward a funny category as well as speed: best crash recovery, best courier uniform, most unnecessary engineering, etc."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000005.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000005.title: "&bCOURIER / VEHICLE RACE"
	task.7A11C0DE17100033.title: "A Race Ran With a Published Route and Safety Rule"
	quest.7A11C0DE17000006.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fGive both sides the same time window and goal: procure a themed bundle, provide a service, attract customers, or solve a public shortage."
		"&fNo fake transactions, item duplication, or quest-reward resale loops. The interesting part is organization and negotiation."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000006.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000006.title: "&6MARKET CHALLENGE"
	task.7A11C0DE1710003D.title: "A Timed Trade/Service Challenge Ended With a Public Result"
	quest.7A11C0DE17000007.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&d&lSAFE RIVALRY FORMAT"
		""
		"&fEach side presents a reversible mascot, mini-build, float, outfit, ceremonial object, or one-chunk display. Neutrals judge or enter an independent category."
		"&fThe server keeps the funniest result only if its owner wants it kept."
		""
		"&7Participation earns the story. Winning earns bragging rights, not better gear."
	]
	quest.7A11C0DE17000007.quest_subtitle: "Optional social contest · reversible by design."
	quest.7A11C0DE17000007.title: "&fMASCOT / ARCHITECTURE SHOWDOWN"
	task.7A11C0DE17100047.title: "Both Sides Presented a Mascot, Mini-Build, or Ceremonial Object"
	quest.7A11C0DE17000008.quest_desc: [
		"{image:minecraft:textures/item/iron_sword.png width:48 height:48 align:center}"
		"&c&lHOSTED, OPT-IN, BACKED UP"
		""
		"&fOnly schedule this after at least two noncombat rivalry activities and when both factions actively want it."
		"&fBefore start: roster, loadout ceiling, arena, spectator protection, inventory-loss rule, backup, stop command, restore plan, and rebuild owner."
		""
		"&eCompletion means the event ended safely and the world was restored/rebuilt as agreed.&f No reward depends on kills or winning."
		""
		"&cIf live PvP controls and backup restoration have not been tested, this quest is 'requires runtime verification' and must remain unused."
	]
	quest.7A11C0DE17000008.quest_subtitle: "A release valve, not the campaign's central mechanic."
	quest.7A11C0DE17000008.title: "&cSANCTIONED SKIRMISH — ONLY IF EVERY BOX IS TRUE"
	task.7A11C0DE17100051.title: "Host Confirms Consent, Backup, Controls, Stop Condition, and Safe End"
	quest.7A11C0DE17000009.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&d&lKEEP THE JOKE, DELETE THE LITTER"
		""
		"&fAfter any two rivalry formats, archive the result: winner if relevant, funniest incident, cleanup status, and one thing to change next time."
		""
		"&eReward:&f a team festival bundle. It helps stage the next event but contains no weapons or faction progression."
		""
		"&8History is what remains after the temporary banners come down."
	]
	quest.7A11C0DE17000009.quest_subtitle: "Two silly contests are enough to make the factions feel real."
	quest.7A11C0DE17000009.title: "&d&lARCHIVE A RIVALRY NIGHT"
	task.7A11C0DE1710005B.title: "Archive the Rivalry Result and Confirm Cleanup"
	reward.7A11C0DE1720005C.title: "Sixteen Firework Rockets"
	reward.7A11C0DE1720005D.title: "Two Cakes"
	reward.7A11C0DE1720005E.title: "Rivalry Night Broadside"

	chapter.7A11C0DE18000000.title: "VvH 08 · The Long Night Fair"
	quest.7A11C0DE18000001.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lTHE SEASON ENDS WITH A PLACE FULL OF PEOPLE"
		""
		"&fSchedule one public fair, tour night, festival, summit, or exhibition using infrastructure the server has actually built. Complete any &e4 of 6&f contribution categories."
		""
		"&7The event should expose unfinished hooks as well as achievements. A good finale creates reasons to log in next week instead of pretending the world is complete."
		""
		"&8Bring lanterns. Bring food. Bring the one machine everyone was told not to turn on indoors."
	]
	quest.7A11C0DE18000001.quest_subtitle: "Any four contributions; no perfect attendance required."
	quest.7A11C0DE18000001.title: "&6&lCALL THE LONG NIGHT FAIR"
	task.7A11C0DE18100001.title: "Date, Location, and Public Invitation Are Posted"
	quest.7A11C0DE18000002.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fProvide a House contribution: Vampire's Delight table, faction tour, archive reading, ritual demonstration, night-route walk, or aesthetic exhibit."
		"&fGuests are not required to become Vampires, fight, or participate in feeding mechanics."
	]
	quest.7A11C0DE18000002.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000002.title: "&4HOUSE OF NIGHT HOSPITALITY"
	task.7A11C0DE18100015.title: "Vampire-Themed Hospitality, Ritual, Tour, or Exhibit Was Hosted"
	quest.7A11C0DE18000003.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fProvide an Order contribution: safety demo, public route briefing, workstation tour, rescue drill, garlic-themed table, or countermeasure museum."
		"&fThe point is public service and faction character, not target practice on unwilling guests."
	]
	quest.7A11C0DE18000003.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000003.title: "&bLANTERN ORDER SERVICE"
	task.7A11C0DE1810001F.title: "Hunter-Themed Safety, Craft, Route, or Public-Service Exhibit Was Hosted"
	quest.7A11C0DE18000004.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fRun a neutral contribution: trades, contracts, map desk, courier service, guesthouse, arbitration, MCA civic exhibit, or event logistics."
		"&fAt least one interaction should cross faction lines."
	]
	quest.7A11C0DE18000004.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000004.title: "&aFREE COMPANY MARKET"
	task.7A11C0DE18100029.title: "Neutral Market, Contract Desk, Mediation Table, or Courier Service Operated"
	quest.7A11C0DE18000005.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fDemonstrate a Create system, vehicle, airframe, dock, rail feature, workshop, or safely controlled engineering failure."
		"&fDesign the spectator area before discovering why propellers need spectator areas."
	]
	quest.7A11C0DE18000005.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000005.title: "&6ENGINEERING / AERONAUTICS EXHIBITION"
	task.7A11C0DE18100033.title: "A Machine, Vehicle, Dock, Workshop, or Controlled Test Was Demonstrated"
	quest.7A11C0DE18000006.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fProvide food, music/performance, mini-game, ceremony, awards, speeches, guided tour, or another contribution that gives players something to do together rather than merely inspect chests."
		"&fUse Farmer's Delight/Vampire's Delight if useful; ordinary Minecraft food is also valid."
	]
	quest.7A11C0DE18000006.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000006.title: "&ePUBLIC FEAST / PERFORMANCE"
	task.7A11C0DE1810003D.title: "A Shared Meal, Performance, Game, or Ceremony Served the Event"
	quest.7A11C0DE18000007.quest_desc: [
		"{image:minecraft:textures/item/lantern.png width:48 height:48 align:center}"
		"&6&lLONG NIGHT CONTRIBUTION"
		""
		"&fBefore the event ends, archive at least five concrete pieces of history: faction changes, projects, rivalry results, failures, screenshots/maps, quotes, contracts, deaths worth remembering, or unfinished hooks."
		"&fFuture players should be able to reconstruct Season One without asking for a three-hour Discord oral history."
	]
	quest.7A11C0DE18000007.quest_subtitle: "Capstone contribution · one real event output."
	quest.7A11C0DE18000007.title: "&fARCHIVE THE SEASON"
	task.7A11C0DE18100047.title: "At Least 5 Season Facts, Images, Maps, Quotes, or Results Were Archived"
	quest.7A11C0DE18000009.quest_desc: [
		"{image:minecraft:textures/item/firework_rocket.png width:48 height:48 align:center}"
		"&6&lAFTER THE BELLS"
		""
		"&fComplete any four Fair contributions, then record one unresolved pressure or ambition that players genuinely want to continue."
		"&fExamples: faction politics, a vehicle project, settlement story, Hordes defense, public work, expedition, magic problem, or infrastructure failure."
		""
		"&eClaim a commemorative Seal and one horizontal favor.&f No boss loot, faction levels, rare weapons, netherite, or finished late-game machine is hidden here."
		""
		"&8A season is complete when it produces a sequel hook, not when the todo list reaches zero."
	]
	quest.7A11C0DE18000009.quest_subtitle: "The reward is useful. The world you built is the actual progression."
	quest.7A11C0DE18000009.title: "&6&lSEAL SEASON ONE"
	task.7A11C0DE1810005B.title: "Archive the Fair and One Genuine Future Hook"
	reward.7A11C0DE1820005C.title: "Season One Seal"
	reward.7A11C0DE1820005D.title: "Choose a Long Night Fair Favor"

	chapter.7A11C0DE19000000.title: "VvH 09 · After the Bells"
	quest.7A11C0DE19000001.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lCIVIC REQUISITIONS"
		""
		"&fThe season is over. These optional seven-day exchanges turn existing Bevels into small public-use caches for maintenance and events."
		""
		"&fPrices are visible, inputs are consumed, and no output creates Bevels, faction levels, weapons, blood, hunter tech, or another item that cheaply reproduces its own price."
		""
		"&eAgree on payer and destination before submitting.&f A team reward exists once per FTB progress container; it is not one cache per teammate."
		""
		"&8Postgame inflation remains undefeated by vibes."
	]
	quest.7A11C0DE19000001.quest_subtitle: "Weekly convenience without a treadmill."
	quest.7A11C0DE19000001.title: "&6&lAFTER THE BELLS"
	task.7A11C0DE19100001.title: "Read the Civic Requisition Terms"
	quest.7A11C0DE19000002.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lWEEKLY TEAM CACHE"
		""
		"&fReceive sixteen Lanterns and thirty-two Torches for a named public route, refuge, hall, or event."
		""
		"&ePrice:&f 1 Bevel. &7Renews seven days after this FTB team claims it."
	]
	quest.7A11C0DE19000002.quest_subtitle: "Roads, halls, refuge routes, and events."
	quest.7A11C0DE19000002.title: "&eLIGHTING REQUISITION — 1 BEVEL"
	task.7A11C0DE19100015.title: "Submit 1 Bevel"
	reward.7A11C0DE19200016.title: "Sixteen Public Lanterns"
	reward.7A11C0DE19200017.title: "Thirty-Two Public Torches"
	quest.7A11C0DE19000003.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lWEEKLY TEAM CACHE"
		""
		"&fReceive thirty-two Rails and eight Powered Rails. Stations, redstone, route design, and locomotion remain your problem."
		""
		"&ePrice:&f 2 Bevels. &7Renews seven days after this FTB team claims it."
	]
	quest.7A11C0DE19000003.quest_subtitle: "A modest rail cache; still requires engineering."
	quest.7A11C0DE19000003.title: "&6TRANSIT REQUISITION — 2 BEVELS"
	task.7A11C0DE1910001F.title: "Submit 2 Bevels"
	reward.7A11C0DE19200020.title: "Thirty-Two Rails"
	reward.7A11C0DE19200021.title: "Eight Powered Rails"
	quest.7A11C0DE19000004.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lWEEKLY TEAM CACHE"
		""
		"&fReceive sixteen Firework Rockets and two Cakes for a scheduled public event. Please do not turn fireworks into a server benchmark."
		""
		"&ePrice:&f 1 Bevel. &7Renews seven days after this FTB team claims it."
	]
	quest.7A11C0DE19000004.quest_subtitle: "Consumable celebration with a cleanup owner."
	quest.7A11C0DE19000004.title: "&dFESTIVAL REQUISITION — 1 BEVEL"
	task.7A11C0DE19100029.title: "Submit 1 Bevel"
	reward.7A11C0DE1920002A.title: "Sixteen Festival Rockets"
	reward.7A11C0DE1920002B.title: "Two Event Cakes"
	quest.7A11C0DE19000005.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lWEEKLY TEAM CACHE"
		""
		"&fReceive four Super Glue and thirty-two Scaffolding. Record which public work received the cache."
		""
		"&ePrice:&f 1 Bevel. &7Renews seven days after this FTB team claims it."
	]
	quest.7A11C0DE19000005.quest_subtitle: "For temporary access and moving parts."
	quest.7A11C0DE19000005.title: "&aREPAIR REQUISITION — 1 BEVEL"
	task.7A11C0DE19100033.title: "Submit 1 Bevel"
	reward.7A11C0DE19200034.title: "Four Super Glue"
	reward.7A11C0DE19200035.title: "Thirty-Two Scaffolding"
	quest.7A11C0DE19000006.quest_desc: [
		"{image:numismatics:textures/item/coin/bevel.png width:48 height:48 align:center}"
		"&6&lWEEKLY TEAM CACHE"
		""
		"&fReceive sixteen Bread and eight Cooked Beef. Faction-specific cuisine remains player-crafted rather than quest-subsidized."
		""
		"&ePrice:&f 1 Bevel. &7Renews seven days after this FTB team claims it."
	]
	quest.7A11C0DE19000006.quest_subtitle: "Meetings, late arrivals, fairs, and rescue runs."
	quest.7A11C0DE19000006.title: "&cHOSPITALITY REQUISITION — 1 BEVEL"
	task.7A11C0DE1910003D.title: "Submit 1 Bevel"
	reward.7A11C0DE1920003E.title: "Sixteen Bread"
	reward.7A11C0DE1920003F.title: "Eight Cooked Beef"
	quest.7A11C0DE19000007.quest_desc: [
		"{image:minecraft:textures/item/writable_book.png width:48 height:48 align:center}"
		"&f&lTURN AN UNFINISHED THING INTO A HOOK"
		""
		"&fWrite a short rumour tied to a real location, player ambition, faction dispute, settlement, threat, unfinished machine, public work, or mystery."
		"&fEnd with a question somebody could act on next session."
		""
		"&7This renews weekly and intentionally grants no item. The archive should create play, not currency."
	]
	quest.7A11C0DE19000007.quest_subtitle: "One paragraph, one real place, one actionable question."
	quest.7A11C0DE19000007.title: "&fARCHIVE A NEW RUMOUR"
	task.7A11C0DE19100047.title: "I Added One Actionable Rumour"
	quest.7A11C0DE19000009.quest_desc: [
		"{image:minecraft:textures/item/filled_map.png width:48 height:48 align:center}"
		"&e&lNAME THE NEXT PRESSURE"
		""
		"&fChoose one unresolved pressure worth a future season and record stakeholders plus evidence that people actually care about it."
		"&fGood candidates include Vampirism politics, a settlement story, an airship project, Hordes defense, border expansion, infrastructure failure, expedition, magical incident, or a rivalry that acquired consequences."
		""
		"&eTeam keepsake:&f one Unresolved Pressure Docket."
	]
	quest.7A11C0DE19000009.quest_subtitle: "Do not pre-author a sequel nobody wants yet."
	quest.7A11C0DE19000009.title: "&eLEAVE A SEASON TWO PRESSURE"
	task.7A11C0DE1910005B.title: "We Recorded One Evidence-Based Season Two Hook"
	reward.7A11C0DE1920005C.title: "Unresolved Pressure Docket"
	// END VvH SEASON ONE
}
